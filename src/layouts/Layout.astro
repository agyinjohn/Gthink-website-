---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, whatsappHref } from '../data/site';

interface Props { title: string; description?: string; theme?: 'light' | 'dark' }
const {
  title,
  description = 'GTHINK is an Accra-based IT company that builds, secures and supports the technology growing businesses run on, and also handles their brand and print.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-GH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/logo-mark.png" type="image/png" />
    <meta name="theme-color" content="#f4f7f9" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GH" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (!sessionStorage.getItem('gt-loaded')) document.documentElement.classList.add('first-load');
        if (sessionStorage.getItem('gt-trans') === '1' && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('trans-in');
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: site.legalName,
      url: Astro.site?.toString(),
      address: { '@type': 'PostalAddress', addressLocality: 'Accra', addressCountry: 'GH' },
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <!-- first-visit intro: the logo, then a wipe -->
    <div class="pre" data-pre aria-hidden="true">
      <div class="pre__logo"><img src="/logo-white.png" alt="" width="252" height="57" /></div>
      <div class="pre__bar"><i data-pre-bar></i></div>
    </div>

    <!-- page transition -->
    <div class="curtain" data-curtain aria-hidden="true"><i></i><i></i></div>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <a class="wa" href={whatsappHref()} target={site.whatsapp ? '_blank' : undefined} rel="noopener" aria-label="Chat with GTHINK on WhatsApp">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.7c-2 0-4-.5-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7Zm5.9-8c-.3-.2-1.9-1-2.2-1s-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6a9.8 9.8 0 0 1-1.8-2.2c-.2-.3 0-.5.1-.7l.5-.6.3-.5v-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6 0-.9.4-.3.3-1.1 1.1-1.1 2.7s1.2 3.2 1.3 3.4c.2.2 2.3 3.5 5.6 4.9 2.8 1.1 3.3.9 3.9.8.6 0 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.8-.4Z"/></svg>
      <span class="wa__tip mono">Chat on WhatsApp</span>
    </a>

    <div class="cookie" data-cookie role="dialog" aria-live="polite" aria-label="Cookie consent" hidden>
      <p>We use essential cookies to run this site, and optional analytics cookies to improve it, in line with the Data Protection Act, 2012 (Act 843). <a class="link" href="/legal/cookies">Cookie Policy</a></p>
      <div class="cookie__btns">
        <button class="btn btn--ghost btn--sm" data-cookie-choice="essential">Essential only</button>
        <button class="btn btn--sm" data-cookie-choice="all">Accept all</button>
      </div>
    </div>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>

<style is:global>
  /* ---------- intro ---------- */
  .pre { position: fixed; inset: 0; z-index: 500; display: none; background: var(--navy); clip-path: inset(0 0 0 0); }
  .first-load .pre { display: grid; place-items: center; }
  .pre__logo { overflow: hidden; }
  .pre__logo img { width: min(252px, 60vw); height: auto; }
  .pre__bar { position: absolute; left: 50%; bottom: 18vh; width: min(220px, 50vw); height: 2px; translate: -50% 0; background: rgba(255,255,255,0.18); overflow: hidden; }
  .pre__bar i { display: block; height: 100%; background: var(--sky); transform: scaleX(0); transform-origin: left; }

  /* ---------- curtain ---------- */
  .curtain { position: fixed; inset: 0; z-index: 400; pointer-events: none; }
  .curtain i { position: absolute; inset: 0; background: var(--navy); transform: scaleY(0); transform-origin: bottom; }
  .curtain i:nth-child(2) { background: var(--blue); }
  .trans-in .curtain i { transform: scaleY(1); }

  /* ---------- whatsapp ---------- */
  .wa {
    position: fixed; right: max(16px, env(safe-area-inset-right, 0px)); bottom: calc(18px + env(safe-area-inset-bottom, 0px)); z-index: 80;
    width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center;
    background: #1fa855; color: #fff; box-shadow: 0 10px 28px -10px rgba(7, 47, 67, 0.55);
    transition: transform 0.3s var(--ease);
  }
  .wa:hover { transform: translateY(-3px); }
  .wa svg { width: 28px; height: 28px; }
  .wa__tip {
    position: absolute; right: 66px; top: 50%; translate: 0 -50%;
    background: var(--navy); color: #fff; padding: 8px 12px; border-radius: 6px; white-space: nowrap;
    opacity: 0; transform: translateX(8px); transition: opacity 0.3s, transform 0.3s var(--ease); pointer-events: none;
  }
  .wa:hover .wa__tip { opacity: 1; transform: none; }

  /* ---------- cookie ---------- */
  .cookie {
    position: fixed; left: max(16px, env(safe-area-inset-left, 0px)); bottom: calc(18px + env(safe-area-inset-bottom, 0px)); z-index: 85;
    width: min(420px, calc(100% - 100px)); padding: 20px; border-radius: 10px;
    background: var(--surface); border: 1px solid var(--line); box-shadow: 0 20px 50px -24px rgba(7, 47, 67, 0.4);
    font-size: 0.92rem; line-height: 1.5;
  }
  .cookie__btns { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  @media (max-width: 520px) { .cookie { width: calc(100% - 32px); bottom: 88px; } }
</style>
