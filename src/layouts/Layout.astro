---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, whatsappHref } from '../data/site';

interface Props { title: string; description?: string; theme?: 'light' | 'dark'; preloadImage?: { src: string; srcset?: string; sizes?: string } }
const {
  title,
  description = 'GTHINK is an Accra-based IT company that builds, secures and supports the technology growing businesses run on, and also handles their brand and print.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const { preloadImage } = Astro.props;
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
---
<!doctype html>
<html lang="en-GH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/g-mark.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/logo-mark.png" type="image/png" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />}
    <meta name="theme-color" content="#f3f6f8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GH" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (!sessionStorage.getItem('gt-loaded')) document.documentElement.classList.add('first-load');
        if (sessionStorage.getItem('gt-trans') === '1' && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('trans-in');
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: site.legalName,
      url: Astro.site?.toString(),
      address: { '@type': 'PostalAddress', addressLocality: 'Accra', addressCountry: 'GH' },
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <!-- first-visit preloader: three threads weave the wordmark -->
    <div class="pre" data-pre aria-hidden="true">
      <div class="pre__threads"><i></i><i></i><i></i></div>
      <div class="pre__word"><span><img src="/logo-white.png" alt="" width="252" height="57" /></span></div>
      <div class="pre__count mono"><span data-pre-count>000</span></div>
    </div>

    <!-- page transition curtain -->
    <div class="curtain" data-curtain aria-hidden="true"><i></i><i></i><i></i><i></i></div>

    <div class="loom" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <a class="wa" href={whatsappHref()} target={site.whatsapp ? '_blank' : undefined} rel="noopener" aria-label="Chat with GTHINK on WhatsApp" data-magnetic>
      <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.7c-2 0-4-.5-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7Zm5.9-8c-.3-.2-1.9-1-2.2-1s-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6a9.8 9.8 0 0 1-1.8-2.2c-.2-.3 0-.5.1-.7l.5-.6.3-.5v-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6 0-.9.4-.3.3-1.1 1.1-1.1 2.7s1.2 3.2 1.3 3.4c.2.2 2.3 3.5 5.6 4.9 2.8 1.1 3.3.9 3.9.8.6 0 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.8-.4Z"/></svg>
      <span class="wa__tip mono">Chat on WhatsApp</span>
    </a>

    <div class="cookie" data-cookie role="dialog" aria-live="polite" aria-label="Cookie consent" hidden>
      <p>We use essential cookies to run this site, and optional analytics cookies to improve it, in line with the Data Protection Act, 2012 (Act 843). <a class="link" href="/legal/cookies">Cookie Policy</a></p>
      <div class="cookie__btns">
        <button class="btn btn--ghost btn--sm" data-cookie-choice="essential">Essential only</button>
        <button class="btn btn--sm" data-cookie-choice="all">Accept all</button>
      </div>
    </div>

    <div class="cursor" data-cursor aria-hidden="true"><span class="cursor__label mono" data-cursor-label></span></div>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>

<style is:global>
  /* ---------- preloader ---------- */
  .pre { position: fixed; inset: 0; z-index: 500; display: none; background: var(--ink); color: var(--paper); }
  .first-load .pre { display: block; }
  .pre { clip-path: inset(0 0 0 0); }
  .pre__threads { position: absolute; inset: 0; display: grid; grid-template-rows: repeat(3, 1fr); }
  .pre__threads i { display: block; transform: scaleX(0); transform-origin: left; }
  .pre__threads i:nth-child(1) { background: var(--tech); }
  .pre__threads i:nth-child(2) { background: var(--brand); transform-origin: right; }
  .pre__threads i:nth-child(3) { background: var(--print); }
  .pre__word { position: absolute; inset: 0; display: grid; place-items: center; overflow: hidden; }
  .pre__word span { display: block; }
  .pre__word img { width: min(420px, 70vw); height: auto; filter: drop-shadow(0 6px 30px rgba(7, 47, 67, 0.35)); }
  .pre__count { position: absolute; right: var(--gutter); bottom: 28px; font-size: 0.8rem; }

  /* ---------- curtain ---------- */
  .curtain { position: fixed; inset: 0; z-index: 400; display: grid; grid-template-columns: repeat(4, 1fr); pointer-events: none; }
  .curtain i { background: var(--ink); transform: scaleY(0); transform-origin: bottom; }
  .trans-in .curtain i { transform: scaleY(1); }
  .curtain i:nth-child(2) { background: var(--tech); }
  .curtain i:nth-child(3) { background: var(--brand); }
  .curtain i:nth-child(4) { background: var(--print); }

  /* ---------- cursor ---------- */
  .cursor {
    position: fixed; left: 0; top: 0; z-index: 450; pointer-events: none;
    width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%;
    background: var(--brand); mix-blend-mode: normal;
    display: grid; place-items: center;
    transition: width 0.45s var(--ease-out), height 0.45s var(--ease-out), margin 0.45s var(--ease-out), background 0.3s, opacity 0.3s;
    opacity: 0;
  }
  .cursor.is-on { opacity: 1; }
  .cursor.is-link { width: 46px; height: 46px; margin: -23px 0 0 -23px; background: transparent; box-shadow: inset 0 0 0 1px var(--brand); }
  .cursor.is-label { width: 96px; height: 96px; margin: -48px 0 0 -48px; background: var(--brand); box-shadow: none; }
  .cursor__label { color: var(--paper); font-size: 0.66rem; opacity: 0; transition: opacity 0.3s; }
  .cursor.is-label .cursor__label { opacity: 1; }
  @media (hover: none), (pointer: coarse) { .cursor { display: none; } }

  /* ---------- whatsapp ---------- */
  .wa {
    position: fixed; right: clamp(14px, 2vw, 28px); bottom: clamp(14px, 2vw, 28px); z-index: 80;
    width: 58px; height: 58px; border-radius: 50%; display: grid; place-items: center;
    background: #25d366; color: #0b3d1e; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.4);
  }
  .wa svg { width: 28px; height: 28px; }
  .wa__tip {
    position: absolute; right: 68px; top: 50%; translate: 0 -50%;
    background: var(--ink); color: var(--paper); padding: 8px 12px; border-radius: 999px; white-space: nowrap; font-size: 0.66rem;
    opacity: 0; transform: translateX(8px); transition: opacity 0.3s, transform 0.4s var(--ease); pointer-events: none;
  }
  .wa:hover .wa__tip { opacity: 1; transform: none; }

  /* ---------- cookie ---------- */
  .cookie {
    position: fixed; left: clamp(14px, 2vw, 28px); bottom: clamp(14px, 2vw, 28px); z-index: 85;
    width: min(440px, calc(100% - 100px)); padding: 20px; border-radius: 6px;
    background: var(--paper); box-shadow: 0 0 0 1px var(--line), 0 20px 50px -20px rgba(0,0,0,0.3);
    font-size: 0.9rem; line-height: 1.45;
  }
  .cookie__btns { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  @media (max-width: 520px) { .cookie { width: calc(100% - 28px); bottom: 86px; } }
</style>
