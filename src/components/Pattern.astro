---
/** Placeholder frame for photography that has not been supplied yet. */
interface Props { seed?: number; label?: string; class?: string; dense?: boolean }
const { seed = 1, label = 'Photo', class: cls = '' } = Astro.props;
const tones = ['var(--navy)', 'var(--blue)', 'var(--navy-deep)'];
const bg = tones[seed % tones.length];
---
<figure class={`pattern ${cls}`} style={`--pbg: ${bg}`}>
  <img src="/logo-mark.png" alt="" width="98" height="83" loading="lazy" />
  {label && <figcaption>{label}</figcaption>}
</figure>
<style>
  .pattern {
    position: relative; margin: 0; overflow: hidden; border-radius: var(--radius);
    background:
      radial-gradient(circle at 85% 15%, rgba(124, 198, 230, 0.25), transparent 45%),
      var(--pbg);
    display: grid; place-items: center; min-height: 160px; height: 100%;
  }
  .pattern img { width: 22%; max-width: 90px; height: auto; filter: brightness(0) invert(1); opacity: 0.18; }
  figcaption {
    position: absolute; left: 12px; bottom: 12px;
    background: rgba(255, 255, 255, 0.92); color: var(--navy); padding: 4px 9px; border-radius: 6px;
    font-size: 0.75rem; font-weight: 600;
  }
</style>
