---
import { site } from '../data/site';
import { solutions } from '../data/solutions';
import Arrow from './Arrow.astro';
const year = 2026;
---
<footer class="ftr dark">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <img src="/logo-white.png" alt="GTHINK Company Limited" width="200" height="45" loading="lazy" />
        <p>One partner for your technology, brand and print.</p>
      </div>
      <form class="ftr__news" data-form="newsletter" action={site.formEndpoint ?? '#'} method="post">
        <label for="nl-email">Plain-language IT advice, once a month</label>
        <div class="ftr__nl">
          <input id="nl-email" type="email" name="email" placeholder="you@company.com" required autocomplete="email" />
          <input class="hp" type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit" class="btn">Subscribe</button>
        </div>
        <p class="form-note" data-note aria-live="polite"></p>
      </form>
    </div>

    <div class="ftr__cols">
      <div>
        <p class="ftr__h">Solutions</p>
        <ul>
          {solutions.map((s) => <li><a href={`/solutions/${s.slug}`}>{s.name}</a></li>)}
          <li><a href="/solutions/managed-it/plans">Managed IT Plans</a></li>
        </ul>
      </div>
      <div>
        <p class="ftr__h">Company</p>
        <ul>
          <li><a href="/about">Our Story</a></li>
          <li><a href="/about#leadership">Leadership</a></li>
          <li><a href="/about#awards">Awards</a></li>
          <li><a href="/about#careers">Careers</a></li>
          <li><a href="/industries">Industries</a></li>
          <li><a href="/case-studies">Case Studies</a></li>
          <li><a href="/insights">Insights</a></li>
        </ul>
      </div>
      <div>
        <p class="ftr__h">Support</p>
        <ul>
          <li><a href="/support">Client Support</a></li>
          <li><a href="/support#ticket">Log a Ticket</a></li>
          <li><a href="/shop">Shop</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div class="ftr__contact">
        <p class="ftr__h">Visit or call</p>
        <p>{site.address ?? <span class="ph">[Address]</span>}, Accra</p>
        <p>GPS: {site.gps ?? <span class="ph">[GA-XXX-XXXX]</span>}</p>
        <p>{site.phone ?? <span class="ph">[+233]</span>}</p>
        <p>{site.email ?? <span class="ph">[email]</span>}</p>
        <ul class="ftr__social">
          {site.social.map((s) => <li>{s.href ? <a href={s.href} rel="noopener" target="_blank">{s.label}</a> : <span>{s.label}</span>}</li>)}
        </ul>
      </div>
    </div>

    <div class="ftr__badges">
      <span>Awards and certifications</span>
      <span class="ph">[Award or certification badges, only those held]</span>
    </div>

    <div class="ftr__legal">
      <span>© {year} {site.legalName}</span>
      <nav aria-label="Legal">
        <a href="/legal/privacy">Privacy Policy</a>
        <a href="/legal/terms">Terms</a>
        <a href="/legal/cookies">Cookie Policy</a>
      </nav>
      <button class="ftr__totop" data-totop>Back to top <Arrow /></button>
    </div>
  </div>
</footer>

<style>
  .ftr { padding-top: clamp(64px, 8vw, 100px); }
  .ftr__top { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: end; padding-bottom: 48px; border-bottom: 1px solid var(--line); }
  .ftr__brand { display: grid; gap: 18px; }
  .ftr__brand img { width: 200px; height: auto; }
  .ftr__brand p { font-family: var(--f-display); font-size: var(--step-2); font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; max-width: 18ch; }
  .ftr__news label { display: block; color: var(--muted); font-size: 0.9rem; margin-bottom: 10px; }
  .ftr__nl { display: flex; gap: 8px; }
  .ftr__nl input[type='email'] { flex: 1; min-width: 0; background: rgba(255,255,255,0.07); border: 1px solid var(--line-strong); color: #fff; font: inherit; padding: 12px 14px; border-radius: 8px; }
  .ftr__nl input::placeholder { color: #87a5b6; }
  .ftr__nl input:focus { outline: none; border-color: var(--sky); }

  .ftr__cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; padding-block: 48px; }
  .ftr__h { font-family: var(--f-display); font-weight: 700; font-size: 0.95rem; margin-bottom: 16px; }
  .ftr__cols li + li { margin-top: 8px; }
  .ftr__cols a, .ftr__contact p { color: #c4d7e2; font-size: 0.95rem; transition: color 0.2s; }
  .ftr__cols a:hover { color: #fff; }
  .ftr__contact p + p { margin-top: 6px; }
  .ftr__social { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 18px; }
  .ftr__social li + li { margin-top: 0 !important; }
  .ftr__social span { color: #87a5b6; font-size: 0.9rem; }

  .ftr__badges { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; padding: 20px 0; border-top: 1px solid var(--line); font-size: 0.9rem; color: var(--muted); }
  .ftr__legal { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-block: 24px calc(24px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--line); font-size: 0.85rem; color: var(--muted); }
  .ftr__legal nav { display: flex; gap: 20px; flex-wrap: wrap; }
  .ftr__legal a:hover, .ftr__totop:hover { color: #fff; }
  .ftr__totop { display: inline-flex; align-items: center; gap: 6px; }
  .ftr__totop :global(.arrow) { width: 14px; height: 14px; rotate: -90deg; }

  @media (max-width: 900px) {
    .ftr__top { grid-template-columns: 1fr; }
    .ftr__cols { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) { .ftr__cols { grid-template-columns: 1fr; } .ftr__nl { flex-direction: column; } }
</style>
