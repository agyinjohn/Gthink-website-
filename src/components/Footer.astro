---
import { site } from '../data/site';
import { solutions } from '../data/solutions';
import Arrow from './Arrow.astro';
const year = 2026;

const company = [
  { label: 'Our Story', href: '/about' },
  { label: 'Leadership', href: '/about#leadership' },
  { label: 'Awards', href: '/about#awards' },
  { label: 'Careers', href: '/about#careers' },
  { label: 'Industries', href: '/industries' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Insights', href: '/insights' },
];
const support = [
  { label: 'Client Support', href: '/support' },
  { label: 'Log a Ticket', href: '/support#ticket' },
  { label: 'Shop', href: '/shop' },
  { label: 'Contact', href: '/contact' },
  { label: 'Free IT Assessment', href: '/contact#enquiry' },
];
const contact = [
  { k: 'Visit', v: site.address ? `${site.address}, Accra` : null, ph: '[Address], Accra' },
  { k: 'GPS', v: site.gps, ph: '[GA-XXX-XXXX]' },
  { k: 'Call', v: site.phone, ph: '[+233]', href: site.phone ? `tel:${site.phone.replace(/\s/g, '')}` : null },
  { k: 'Email', v: site.email, ph: '[email]', href: site.email ? `mailto:${site.email}` : null },
];
---
<footer class="ftr dark">
  <div class="wrap">
    <!-- brand + links -->
    <div class="ftr__main">
      <div class="ftr__brand">
        <img class="ftr__logo" src="/logo-white.png" alt="GTHINK Company Limited" width="200" height="45" loading="lazy" />
        <p class="ftr__about">IT, software, security, brand and print for growing businesses in Ghana. One team, one invoice.</p>
        <dl class="ftr__contact">
          {contact.map((c) => (
            <div>
              <dt class="mono">{c.k}</dt>
              <dd>{c.v ? (c.href ? <a href={c.href}>{c.v}</a> : c.v) : <span class="ph">{c.ph}</span>}</dd>
            </div>
          ))}
        </dl>
      </div>

      <nav class="ftr__nav" aria-label="Footer">
        <div class="ftr__col">
          <p class="mono ftr__h">Solutions</p>
          <ul>
            {solutions.map((s) => <li><a href={`/solutions/${s.slug}`}>{s.name}<Arrow /></a></li>)}
            <li><a href="/solutions/managed-it/plans">Managed IT Plans<Arrow /></a></li>
          </ul>
        </div>
        <div class="ftr__col">
          <p class="mono ftr__h">Company</p>
          <ul>{company.map((l) => <li><a href={l.href}>{l.label}<Arrow /></a></li>)}</ul>
        </div>
        <div class="ftr__col">
          <p class="mono ftr__h">Support</p>
          <ul>{support.map((l) => <li><a href={l.href}>{l.label}<Arrow /></a></li>)}</ul>
        </div>
      </nav>
    </div>

    <!-- newsletter -->
    <form class="ftr__news" data-form="newsletter" action={site.formEndpoint ?? '#'} method="post">
      <div class="ftr__news-copy">
        <label for="nl-email" class="ftr__news-t">Plain-language IT advice, once a month.</label>
        <p class="ftr__news-s">Short, practical and free. No spam, unsubscribe any time.</p>
      </div>
      <div class="ftr__nl">
        <input id="nl-email" type="email" name="email" placeholder="you@company.com" required autocomplete="email" />
        <input class="hp" type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit" class="ftr__sub">Subscribe <Arrow /></button>
      </div>
      <p class="form-note ftr__note" data-note aria-live="polite"></p>
    </form>

    <!-- awards + social -->
    <div class="ftr__strip">
      <div class="ftr__badges">
        <span class="mono">Awards &amp; certifications</span>
        <span class="ph">[Award or certification badges, only those held]</span>
      </div>
      <ul class="ftr__social" aria-label="Social media">
        {site.social.map((s) => (
          <li>{s.href ? <a href={s.href} rel="noopener" target="_blank">{s.label}</a> : <span title="Link to be added">{s.label}</span>}</li>
        ))}
      </ul>
    </div>
  </div>

  <!-- sign-off -->
  <div class="ftr__word" aria-hidden="true" data-footword>
    <span>G</span><span>T</span><span>H</span><span>I</span><span>N</span><span>K</span>
  </div>

  <div class="wrap ftr__legal">
    <span class="mono">© {year} {site.legalName}</span>
    <nav aria-label="Legal">
      <a class="mono" href="/legal/privacy">Privacy Policy</a>
      <a class="mono" href="/legal/terms">Terms</a>
      <a class="mono" href="/legal/cookies">Cookie Policy</a>
    </nav>
    <button class="mono ftr__top-btn" data-totop>Back to top ↑</button>
  </div>
</footer>

<style>
  .ftr { padding-top: clamp(72px, 9vw, 120px); overflow: hidden; }

  /* brand + links */
  .ftr__main { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 6vw, 96px); padding-bottom: clamp(48px, 6vw, 72px); }
  .ftr__brand { display: grid; gap: 22px; align-content: start; }
  .ftr__logo { width: 190px; height: auto; }
  .ftr__about { max-width: 36ch; color: #c7dae5; font-size: 1.02rem; line-height: 1.55; }
  .ftr__contact { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px; margin: 8px 0 0; padding-top: 22px; border-top: 1px solid var(--line); }
  .ftr__contact div { display: grid; gap: 4px; min-width: 0; }
  .ftr__contact dt { font-size: 0.64rem; color: var(--muted); }
  .ftr__contact dd { margin: 0; font-size: 0.95rem; overflow-wrap: anywhere; }
  .ftr__contact a:hover { color: var(--print); }

  .ftr__nav { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 28px; }
  .ftr__h { color: var(--muted); margin-bottom: 16px; font-size: 0.66rem; }
  .ftr__col ul { display: grid; gap: 2px; }
  .ftr__col a {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 0;
    color: #dbe8ef; font-size: 0.97rem; transition: color 0.2s;
  }
  .ftr__col a :global(.arrow) { width: 13px; height: 13px; opacity: 0; transform: translateX(-4px); transition: opacity 0.25s, transform 0.35s var(--ease); }
  .ftr__col a:hover, .ftr__col a:focus-visible { color: var(--paper); }
  .ftr__col a:hover :global(.arrow), .ftr__col a:focus-visible :global(.arrow) { opacity: 1; transform: none; color: var(--print); }

  /* newsletter */
  .ftr__news {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 16px 40px; align-items: center;
    padding: clamp(22px, 3vw, 32px); border-radius: 8px; background: #0b3a52;
  }
  .ftr__news-copy { display: grid; gap: 4px; }
  .ftr__news-t { font-size: var(--step-1); font-weight: 540; letter-spacing: -0.015em; line-height: 1.25; }
  .ftr__news-s { color: var(--muted); font-size: 0.92rem; }
  .ftr__nl { display: flex; gap: 8px; }
  .ftr__nl input[type='email'] {
    flex: 1; min-width: 0; padding: 14px 18px; border-radius: 999px;
    background: rgba(243, 246, 248, 0.06); border: 1px solid var(--line-strong); color: inherit; font: inherit;
    transition: border-color 0.2s, background 0.2s;
  }
  .ftr__nl input::placeholder { color: #8fb0c2; }
  .ftr__nl input:focus { outline: none; border-color: var(--print); background: rgba(243, 246, 248, 0.1); }
  .ftr__sub {
    flex: none; display: inline-flex; align-items: center; gap: 8px; padding: 14px 20px; border-radius: 999px;
    background: var(--brand); color: var(--paper); font-weight: 540; transition: background 0.25s, color 0.25s;
  }
  .ftr__sub:hover { background: var(--paper); color: var(--ink); }
  .ftr__sub :global(.arrow) { width: 15px; height: 15px; }
  .ftr__note { grid-column: 2; margin-top: -6px; }
  .ftr__note:empty { display: none; }

  /* awards + social */
  .ftr__strip { display: flex; justify-content: space-between; align-items: center; gap: 16px 32px; flex-wrap: wrap; padding-block: 26px; }
  .ftr__badges { display: flex; gap: 10px 20px; align-items: center; flex-wrap: wrap; }
  .ftr__badges .mono { color: var(--muted); font-size: 0.66rem; }
  .ftr__social { display: flex; flex-wrap: wrap; gap: 8px; }
  .ftr__social a, .ftr__social span {
    display: inline-block; padding: 8px 14px; border-radius: 999px; font-size: 0.86rem;
    box-shadow: inset 0 0 0 1px var(--line-strong); transition: background 0.25s, color 0.25s;
  }
  .ftr__social span { color: var(--muted); }
  .ftr__social a:hover { background: var(--paper); color: var(--ink); }

  /* sign-off wordmark: quiet, so it closes the page without shouting */
  .ftr__word {
    display: flex; justify-content: space-between; overflow: hidden;
    padding: 0.04em var(--gutter) 0.08em; margin-top: clamp(8px, 2vw, 24px);
    font-size: clamp(4.5rem, 23vw, 25rem); font-weight: 700; line-height: 0.82;
    letter-spacing: -0.06em; font-variation-settings: 'opsz' 96, 'wdth' 75;
    color: rgba(124, 198, 230, 0.13); user-select: none;
  }
  .ftr__word span { display: inline-block; transform-origin: bottom; }
  .ftr__word span:first-child { color: rgba(243, 246, 248, 0.2); }

  .ftr__legal { display: flex; justify-content: space-between; align-items: center; gap: 12px 24px; padding-block: 22px calc(22px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--line); flex-wrap: wrap; }
  .ftr__legal nav { display: flex; gap: 20px; flex-wrap: wrap; }
  .ftr__legal .mono { font-size: 0.66rem; color: var(--muted); transition: color 0.3s; }
  .ftr__legal a:hover, .ftr__top-btn:hover { color: var(--paper); }

  @media (max-width: 960px) {
    .ftr__main { grid-template-columns: 1fr; }
    .ftr__news { grid-template-columns: 1fr; }
    .ftr__note { grid-column: 1; }
  }
  @media (max-width: 640px) {
    .ftr__nav { grid-template-columns: 1fr 1fr; gap: 28px 20px; }
    .ftr__nav .ftr__col:first-child { grid-column: 1 / -1; }
    .ftr__nav .ftr__col:first-child ul { grid-template-columns: 1fr 1fr; column-gap: 20px; }
    .ftr__col a { font-size: 0.93rem; }
    .ftr__nl { flex-direction: column; }
    .ftr__sub { justify-content: center; }
    .ftr__legal { flex-direction: column; align-items: flex-start; }
  }
</style>
