---
import { site, whatsappHref } from '../data/site';
import Arrow from './Arrow.astro';
import Ph from './Ph.astro';
interface Props { title?: string }
const { title } = Astro.props;
---
<section class="cta-sec">
  <div class="wrap">
    <div class="cta">
      <div class="cta__copy">
        <p class="eyebrow" data-reveal>Free IT assessment</p>
        <h2 class="h2" data-split>{title ? <Fragment set:html={title} /> : <>Not sure where to start? <span class="serif">Get a free IT assessment.</span></>}</h2>
        <p class="cta__body" data-reveal>We review your systems, security and costs, then send a clear plan within <Ph value={site.assessmentDays} label="X" /> business days.</p>
      </div>
      <div class="cta__btns" data-reveal>
        <a href="/contact#enquiry" class="btn">Book Assessment <Arrow /></a>
        <a href={whatsappHref('Hello GTHINK, I would like a free IT assessment.')} class="btn btn--wa">Chat on WhatsApp</a>
      </div>
    </div>
  </div>
</section>
<style>
  .cta-sec { padding-block: clamp(48px, 7vw, 96px); }
  .cta {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 32px;
    padding: clamp(32px, 5vw, 64px); border-radius: 16px;
    background: var(--navy); color: #fff;
  }
  .cta::after {
    content: ''; position: absolute; right: -80px; top: -80px; width: 280px; height: 280px; border-radius: 50%;
    border: 40px solid rgba(124, 198, 230, 0.12); pointer-events: none;
  }
  .cta__copy { display: grid; gap: 16px; position: relative; }
  .cta .eyebrow { color: var(--sky); }
  .cta .h2 { max-width: 18ch; }
  .cta .serif { color: var(--sky); }
  .cta__body { color: #c4d7e2; font-size: var(--step-1); max-width: 46ch; }
  .cta__body :global(.ph) { color: #a9c3d2; }
  .cta__btns { display: flex; gap: 10px; flex-wrap: wrap; position: relative; }
  .cta__btns .btn:not(.btn--wa) { background: #fff; color: var(--navy); }
  .cta__btns .btn:not(.btn--wa):hover { background: var(--sky); }
  @media (max-width: 860px) { .cta { grid-template-columns: 1fr; } }
</style>
