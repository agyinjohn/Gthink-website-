---
import { solutions } from '../data/solutions';
import Arrow from './Arrow.astro';
import Icon from './Icon.astro';
---
<div class="sgrid" data-stagger>
  {solutions.map((s) => (
    <a href={`/solutions/${s.slug}`} class="scard">
      <span class="scard__icon"><Icon name={s.slug} /></span>
      <h2 class="scard__name">{s.name}</h2>
      <p class="scard__short">{s.short}</p>
      <ul class="scard__list">{s.deliver.slice(0, 3).map((d) => <li>{d.replace(/\s*\[[^\]]+\]/, '')}</li>)}</ul>
      <span class="link">Learn more <Arrow /></span>
    </a>
  ))}
</div>
<style>
  .sgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .scard { display: flex; flex-direction: column; gap: 12px; padding: 28px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; transition: border-color 0.25s, box-shadow 0.3s, transform 0.3s var(--ease); }
  .scard:hover { border-color: var(--blue); box-shadow: 0 20px 40px -28px rgba(7, 47, 67, 0.45); transform: translateY(-4px); }
  .scard__icon { width: 52px; height: 52px; border-radius: 10px; background: var(--surface-2); color: var(--blue); display: grid; place-items: center; margin-bottom: 6px; transition: background 0.25s, color 0.25s; }
  .scard:hover .scard__icon { background: var(--blue); color: #fff; }
  .scard__icon :global(svg) { width: 26px; height: 26px; }
  .scard__name { font-size: var(--step-1); color: var(--navy); }
  .scard__short { color: var(--muted); }
  .scard__list { display: grid; gap: 6px; padding: 14px 0; border-top: 1px solid var(--line); flex: 1; font-size: 0.92rem; }
  .scard__list li { padding-left: 16px; position: relative; }
  .scard__list li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 6px; height: 6px; border-radius: 2px; background: var(--blue); }
  .scard .link { align-self: flex-start; }
  @media (max-width: 900px) { .sgrid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .sgrid { grid-template-columns: 1fr; } }
</style>
