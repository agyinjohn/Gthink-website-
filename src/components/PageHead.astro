---
interface Props { index: string; label: string; title: string; lede?: string }
const { index, label, title, lede } = Astro.props;
import T from './T.astro';
---
<section class="phead wrap">
  <div class="phead__meta">
    <span class="eyebrow" data-reveal="hero">{label}</span>
    <span class="mono muted" data-reveal="hero">{index}</span>
  </div>
  <h1 class="phead__title" data-split="hero" set:html={title} />
  <div class="phead__bottom">
    {lede && <p class="lede" data-reveal="hero"><T text={lede} /></p>}
    <slot />
  </div>
  <hr class="rule phead__rule" data-draw />
</section>
<style>
  .phead__rule { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 0; }
  :global(.phead__title .serif) { color: var(--brand); }
</style>
