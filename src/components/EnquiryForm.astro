---
import { site } from '../data/site';
import Arrow from './Arrow.astro';
interface Props { preset?: string; id?: string }
const { preset, id = 'enquiry' } = Astro.props;
const needs = ['Software', 'Managed IT', 'Cybersecurity', 'Networks', 'Cloud', 'Brand and Print', 'Shop'];
---
<form class="form" id={id} data-form="enquiry" action={site.formEndpoint ?? '#'} method="post">
  <div class="row">
    <div class="field"><label for={`${id}-name`}>Name</label><input id={`${id}-name`} name="name" required autocomplete="name" /></div>
    <div class="field"><label for={`${id}-company`}>Company</label><input id={`${id}-company`} name="company" autocomplete="organization" /></div>
  </div>
  <div class="row">
    <div class="field"><label for={`${id}-phone`}>Phone</label><input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" /></div>
    <div class="field"><label for={`${id}-email`}>Email</label><input id={`${id}-email`} name="email" type="email" required autocomplete="email" /></div>
  </div>
  <fieldset class="field">
    <legend>What do you need?</legend>
    <div class="chips">
      {needs.map((n) => (
        <label class="chip"><input type="checkbox" name="need" value={n} checked={preset === n} /><span>{n}</span></label>
      ))}
    </div>
  </fieldset>
  <div class="field"><label for={`${id}-msg`}>Message</label><textarea id={`${id}-msg`} name="message" rows="4"></textarea></div>
  <fieldset class="field">
    <legend>Preferred contact</legend>
    <div class="chips">
      {['Call', 'WhatsApp', 'Email'].map((n, i) => (
        <label class="chip"><input type="radio" name="contact_by" value={n} checked={i === 1} /><span>{n}</span></label>
      ))}
    </div>
  </fieldset>
  <input class="hp" type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="form__end">
    <button type="submit" class="btn">Send Enquiry <Arrow /></button>
    <p class="form-note" data-note aria-live="polite"></p>
  </div>
</form>
<style>
  .form__end { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; margin-top: 10px; }
</style>
