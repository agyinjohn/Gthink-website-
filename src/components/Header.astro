---
import { site, nav } from '../data/site';
import { solutions } from '../data/solutions';
import Arrow from './Arrow.astro';
const path = Astro.url.pathname;
const overHero = path === '/' || path === '/index.html';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class:list={['hdr', { 'hdr--over': overHero }]} data-header>
  <div class="util">
    <div class="wrap util__in">
      <span class="mono util__loc">Accra, Ghana · <span data-clock>--:--</span> GMT</span>
      <nav class="util__links" aria-label="Utility">
        <a href="/support" class="mono">Client Support</a>
        <a href="/shop" class="mono">Shop</a>
        {site.phone ? <a class="mono" href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a> : <span class="mono ph">[Phone]</span>}
      </nav>
    </div>
  </div>

  <div class="wrap bar">
    <a href="/" class="logo" aria-label="GTHINK Company Limited, home">
      <img class="logo__dark" src="/logo.png" alt="GTHINK Company Limited" width="176" height="40" />
      <img class="logo__light" src="/logo-white.png" alt="" width="176" height="40" aria-hidden="true" />
    </a>

    <nav class="menu" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li class={n.mega ? 'has-mega' : ''}>
            <a href={n.href} class:list={['menu__a', { active: isActive(n.href) }]} aria-haspopup={n.mega ? 'true' : undefined}>
              <span data-text={n.label}>{n.label}</span>
              {n.mega && <svg class="chev" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5l3-3" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>}
            </a>
            {n.mega && (
              <div class="mega" id="mega-solutions">
                <div class="mega__panel">
                  <div class="mega__aside">
                    <p class="eyebrow">Solutions</p>
                    <p class="mega__lead">Everything your business runs on, handled by one team.</p>
                    <div class="mega__links">
                      <a href="/solutions" class="mega__btn">All solutions <Arrow /></a>
                      <a href="/solutions/managed-it/plans" class="mega__btn mega__btn--ghost">Compare Managed IT plans <Arrow /></a>
                    </div>
                  </div>
                  <div class="mega__main">
                    <ul class="mega__grid">
                      {solutions.map((s, i) => (
                        <li style={`--i: ${i}`}>
                          <a href={`/solutions/${s.slug}`} class="mega__item">
                            <span class="mono mega__n">0{i + 1}</span>
                            <span class="mega__txt">
                              <span class="mega__name">{s.name}</span>
                              <span class="mega__short">{s.short}</span>
                            </span>
                            <span class="mega__go" aria-hidden="true"><Arrow /></span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a href="/contact#enquiry" class="mega__foot">
                      <span>Not sure what you need? <b>Book a free IT assessment</b></span>
                      <Arrow />
                    </a>
                  </div>
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a href="/contact" class="btn btn--sm bar__cta" data-magnetic>Get a Quote <Arrow /></a>

    <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-burger>
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="mm" id="mobile-menu" data-mm aria-hidden="true">
  <div class="mm__bg"><i></i><i></i><i></i></div>
  <div class="wrap mm__in">
    <ul class="mm__list">
      <li><a href="/"><span class="mono">00</span>Home</a></li>
      {nav.map((n, i) => <li><a href={n.href}><span class="mono">0{i + 1}</span>{n.label}</a></li>)}
    </ul>
    <div class="mm__foot">
      <a href="/support" class="mono">Client Support</a>
      <a href="/shop" class="mono">Shop</a>
      <a href="/solutions/managed-it/plans" class="mono">Managed IT Plans</a>
      <a href="/contact" class="btn">Get a Quote <Arrow /></a>
    </div>
  </div>
</div>

<style>
  .hdr { position: fixed; inset: 0 0 auto 0; z-index: 90; transition: transform 0.7s var(--ease); }
  .hdr.is-hidden { transform: translateY(-100%); }
  .hdr::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--paper);
    opacity: 0; transition: opacity 0.4s;
  }
  .hdr.is-scrolled::before { opacity: 1; }
  .hdr.is-scrolled { box-shadow: 0 1px 0 var(--line); }

  .util { border-bottom: 1px solid var(--line); transition: margin 0.5s var(--ease); }
  .hdr.is-scrolled .util { margin-top: -37px; }
  .util__in { display: flex; justify-content: space-between; align-items: center; height: 36px; }
  .util .mono { font-size: 0.68rem; }
  .util__links { display: flex; gap: 22px; }
  .util__links a { opacity: 0.8; transition: opacity 0.3s; }
  .util__links a:hover { opacity: 1; }

  .bar { display: flex; align-items: center; gap: 28px; height: 76px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; margin-right: auto; }
  .logo img { width: 172px; height: auto; transition: opacity 0.3s; }
  .logo:hover img { opacity: 0.85; }
  @media (max-width: 420px) { .logo img { width: 146px; } }

  .menu > ul { display: flex; gap: 4px; }
  .menu__a { position: relative; display: block; margin: 10px 12px; line-height: 1.25; font-size: 0.95rem; font-weight: 480; overflow: hidden; }
  .menu__a span { position: relative; display: inline-block; transition: transform 0.55s var(--ease); }
  .menu__a span::after { content: attr(data-text); position: absolute; left: 0; top: 100%; color: var(--brand); }
  .menu__a:hover span { transform: translateY(-100%); }
  .menu__a { overflow: clip; overflow-clip-margin: 0; }
  .menu__a.active { overflow: visible; }
  .menu__a.active span::after { display: none; }
  .menu__a.active::before { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; background: linear-gradient(90deg, var(--tech) 0 33.3%, var(--brand) 0 66.6%, var(--print) 0); }

  .has-mega { position: static; }
  .has-mega > .menu__a { display: inline-flex; align-items: center; gap: 5px; }
  .chev { width: 10px; height: 10px; transition: rotate 0.4s var(--ease); }
  .has-mega:hover .chev, .has-mega:focus-within .chev { rotate: 180deg; }

  /* Solutions dropdown: a light panel under the bar */
  .mega {
    position: absolute; left: 0; right: 0; top: 100%; padding-top: 10px;
    visibility: hidden; opacity: 0; transform: translateY(-8px); pointer-events: none;
    transition: opacity 0.25s, transform 0.45s var(--ease), visibility 0s 0.45s;
  }
  .has-mega:hover .mega, .has-mega:focus-within .mega {
    visibility: visible; opacity: 1; transform: none; pointer-events: auto;
    transition: opacity 0.25s, transform 0.45s var(--ease), visibility 0s;
  }
  .mega__panel {
    width: calc(100% - 2 * var(--gutter)); max-width: 1120px; margin-inline: auto;
    display: grid; grid-template-columns: 290px minmax(0, 1fr);
    background: var(--paper); color: var(--ink); border-radius: 10px; overflow: hidden;
    box-shadow: 0 0 0 1px var(--line), 0 34px 70px -30px rgba(7, 47, 67, 0.45);
  }

  .mega__aside {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; gap: 14px; padding: 28px 26px;
    background: var(--ink); color: var(--paper);
  }
  .mega__aside::after {
    content: ''; position: absolute; z-index: -1; right: -60px; bottom: -50px; width: 220px; aspect-ratio: 98 / 83;
    background: var(--paper); opacity: 0.05;
    -webkit-mask: url('/g-mark.svg') center / contain no-repeat; mask: url('/g-mark.svg') center / contain no-repeat;
  }
  .mega__aside .eyebrow::before { background: var(--print); }
  .mega__lead { font-size: 1.35rem; font-weight: 520; line-height: 1.15; letter-spacing: -0.025em; }
  .mega__links { margin-top: auto; display: grid; gap: 8px; padding-top: 18px; }
  .mega__btn {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    padding: 12px 14px; border-radius: 8px; font-size: 0.88rem; font-weight: 520;
    background: var(--brand); color: var(--paper); transition: background 0.25s, color 0.25s;
  }
  .mega__btn:hover { background: var(--paper); color: var(--ink); }
  .mega__btn--ghost { background: transparent; box-shadow: inset 0 0 0 1px rgba(243, 246, 248, 0.3); }
  .mega__btn :global(.arrow) { width: 15px; height: 15px; flex: none; }

  .mega__main { display: flex; flex-direction: column; padding: 12px; }
  .mega__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 6px; }
  .mega__grid li { opacity: 0; transform: translateY(6px); transition: opacity 0.3s, transform 0.45s var(--ease); transition-delay: 0s; }
  .has-mega:hover .mega__grid li, .has-mega:focus-within .mega__grid li { opacity: 1; transform: none; transition-delay: calc(60ms + var(--i) * 30ms); }
  .mega__item {
    display: grid; grid-template-columns: 26px minmax(0, 1fr) 18px; gap: 12px; align-items: start;
    padding: 16px 14px; border-radius: 8px; transition: background 0.2s;
  }
  .mega__item:hover, .mega__item:focus-visible { background: var(--paper-2); }
  .mega__n { padding-top: 4px; font-size: 0.66rem; color: var(--brand); }
  .mega__name { display: block; font-size: 1rem; font-weight: 560; letter-spacing: -0.015em; transition: color 0.2s; }
  .mega__item:hover .mega__name { color: var(--brand); }
  .mega__short { display: block; margin-top: 3px; font-size: 0.86rem; line-height: 1.4; color: var(--muted); }
  .mega__go { padding-top: 2px; color: var(--brand); opacity: 0; transform: translateX(-6px); transition: opacity 0.25s, transform 0.35s var(--ease); }
  .mega__item:hover .mega__go, .mega__item:focus-visible .mega__go { opacity: 1; transform: none; }
  .mega__go :global(.arrow) { width: 16px; height: 16px; }
  .mega__foot {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    margin: 8px 2px 0; padding: 14px 12px 6px; border-top: 1px solid var(--line);
    font-size: 0.9rem; color: var(--muted);
  }
  .mega__foot b { color: var(--ink); font-weight: 560; transition: color 0.2s; }
  .mega__foot:hover b { color: var(--brand); }
  .mega__foot :global(.arrow) { width: 16px; height: 16px; color: var(--brand); transition: transform 0.35s var(--ease); }
  .mega__foot:hover :global(.arrow) { transform: translateX(4px); }

  .btn--sm { padding: 12px 16px 12px 18px; font-size: 0.9rem; }

  .burger { display: none; width: 44px; height: 44px; border-radius: 50%; background: var(--ink); position: relative; z-index: 101; }
  .burger span { position: absolute; left: 13px; right: 13px; height: 1.5px; background: var(--paper); transition: transform 0.6s var(--ease), top 0.6s var(--ease); }
  .burger span:first-child { top: 18px; }
  .burger span:last-child { top: 25px; }
  .menu-open .burger span:first-child { top: 21.5px; transform: rotate(45deg); }
  .menu-open .burger span:last-child { top: 21.5px; transform: rotate(-45deg); }

  .mm { position: fixed; inset: 0; z-index: 89; visibility: hidden; }
  .mm__bg { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(3, 1fr); }
  .mm__bg i { background: var(--ink); transform: scaleY(0); transform-origin: top; }
  .mm__in { position: relative; height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding-top: 130px; padding-bottom: 32px; color: var(--paper); }
  .mm__list a { display: flex; align-items: baseline; gap: 14px; font-size: clamp(2.4rem, 11vw, 4.5rem); font-weight: 560; letter-spacing: -0.045em; line-height: 1.05; font-variation-settings: 'opsz' 96, 'wdth' 85; }
  .mm__list .mono { font-size: 0.7rem; color: var(--print); }
  .mm__list li { overflow: hidden; }
  .mm__foot { display: flex; flex-wrap: wrap; gap: 14px 22px; align-items: center; }
  .mm__foot .btn { margin-top: 8px; }

  @media (max-width: 1080px) {
    .menu, .bar__cta { display: none; }
    .burger { display: block; }
    .util__loc { display: none; }
    .util__in { justify-content: flex-end; }
  }
  .menu-open .hdr::before { opacity: 0; }

  /* Over the homepage hero photo: light header until the page scrolls */
  .logo { position: relative; }
  .logo__light { position: absolute; left: 0; top: 50%; translate: 0 -50%; opacity: 0; }
  .hdr--over:not(.is-scrolled) .logo__dark { opacity: 0; }
  .hdr--over:not(.is-scrolled) .logo__light { opacity: 1; }
  .hdr--over:not(.is-scrolled) { color: var(--paper); }
  .hdr--over:not(.is-scrolled) .util { border-bottom-color: rgba(243, 246, 248, 0.2); }
  .hdr--over:not(.is-scrolled) .menu__a.active::before { background: var(--paper); }
  .hdr--over:not(.is-scrolled) .bar__cta { --bg: var(--paper); --fg: var(--ink); }
  .hdr--over:not(.is-scrolled) .bar__cta:hover { color: var(--paper); }
  .hdr--over:not(.is-scrolled) .burger { background: var(--paper); }
  .hdr--over:not(.is-scrolled) .burger span { background: var(--ink); }
  .hdr { transition: transform 0.7s var(--ease), color 0.4s; }
  .logo img { transition: opacity 0.4s; }
  .menu-open .util { opacity: 0; pointer-events: none; }
  .menu-open .hdr { box-shadow: none; }
  .menu-open .logo { position: relative; z-index: 101; }
  .menu-open .logo img { filter: brightness(0) invert(1); }
  .menu-open .burger { background: var(--paper); }
  .menu-open .burger span { background: var(--ink); }
</style>
