---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import Arrow from '../../components/Arrow.astro';
import T from '../../components/T.astro';
import Pattern from '../../components/Pattern.astro';
import { cases, type CaseStudy } from '../../data/content';
import { solutions } from '../../data/solutions';

export function getStaticPaths() {
  return cases.map((c, i) => ({ params: { slug: c.slug }, props: { c, i } }));
}
const { c, i } = Astro.props as { c: CaseStudy; i: number };
const next = cases[(i + 1) % cases.length];
const solSlug = solutions.find((s) => c.solution.toLowerCase().startsWith(s.name.toLowerCase().split(' ')[0]))?.slug ?? '';
const glance = [
  { k: 'Client', v: c.client },
  { k: 'Sector', v: c.sector },
  { k: 'Solution', v: c.solution },
  { k: 'Timeline', v: c.timeline },
];
const plain = (s: string) => s.replace(/[\[\]]/g, '');
---
<Layout title={`Case Study: ${plain(c.result)} | GTHINK`} description={c.summary}>
  <article style={`--c: var(--${c.thread})`}>
    <!-- header -->
    <header class="ch wrap">
      <div class="ch__meta">
        <a href="/case-studies" class="link ch__back" data-reveal="hero"><Arrow class="arrow back" /> All case studies</a>
        <span class="mono muted" data-reveal="hero">Case 0{i + 1} / 0{cases.length}</span>
      </div>
      <p class="eyebrow" data-reveal="hero">{c.solution}</p>
      <h1 class="ch__title" data-reveal="hero"><T text={c.result} /></h1>
      <p class="lede muted" data-reveal="hero">{c.summary}</p>
    </header>

    <div class="wrap">
      <div class="ch__media" data-reveal="hero">
        <div class="ch__img" data-parallax="0.08"><Pattern seed={i + 2} img={c.img} label="Case photo" /></div>
      </div>
    </div>

    <!-- at a glance -->
    <section class="wrap">
      <dl class="glance" data-stagger>
        {glance.map((g) => <div><dt class="mono">{g.k}</dt><dd><T text={g.v} /></dd></div>)}
      </dl>
    </section>

    <!-- challenge -->
    <section class="section">
      <div class="wrap split">
        <div class="sticky">
          <p class="eyebrow" data-reveal>The challenge</p>
          <h2 class="h2" data-split>In the client’s <span class="serif">own words.</span></h2>
        </div>
        <blockquote class="challenge" data-reveal><T text={c.challenge} /></blockquote>
      </div>
    </section>

    <!-- what we did -->
    <section class="section sand">
      <div class="wrap split">
        <div class="sticky">
          <p class="eyebrow" data-reveal>What we did</p>
          <h2 class="h2" data-split>The main <span class="serif">steps.</span></h2>
          {solSlug && <a href={`/solutions/${solSlug}`} class="link sol-link" data-reveal>About {c.solution.split(' · ')[0]} <Arrow /></a>}
        </div>
        <ol class="steps" data-stagger>
          {c.steps.map((s, k) => <li><span class="steps__n">{k + 1}</span><span><T text={s} /></span></li>)}
        </ol>
      </div>
    </section>

    <!-- results -->
    <section class="section dark">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow" data-reveal>The results</p>
          <h2 class="h2" data-split>Numbers the client <span class="serif">can check.</span></h2>
        </div>
        <ul class="res" data-stagger>
          {c.results.map((r) => <li><b><T text={r.n} /></b><span>{r.l}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- quote -->
    <section class="section">
      <div class="wrap">
        <figure class="quote" data-reveal>
          <span class="quote__mark" aria-hidden="true">“</span>
          <blockquote><T text={c.quote} /></blockquote>
          <figcaption class="mono muted"><T text={c.who} /></figcaption>
        </figure>
      </div>
    </section>

    <!-- next -->
    <a href={`/case-studies/${next.slug}`} class="next" data-cursor-text="Next">
      <div class="wrap next__in">
        <span class="mono">Next case study · {next.solution}</span>
        <span class="next__name"><T text={next.result} /></span>
        <span class="next__go" aria-hidden="true"><Arrow /></span>
      </div>
    </a>
  </article>

  <CTA title='Want results like these? <span class="serif">Get similar results.</span>' />
</Layout>

<style>
  .ch { padding-top: clamp(140px, 17vw, 200px); padding-bottom: clamp(36px, 5vw, 56px); display: grid; gap: 22px; }
  .ch__meta { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 12px; }
  .ch__back :global(.back) { rotate: 180deg; }
  .ch__title { font-size: var(--step-4); max-width: 20ch; }
  .ch__title :global(.ph) { white-space: normal; }
  .ch .lede { max-width: 52ch; }

  .ch__media { position: relative; aspect-ratio: 21 / 9; border-radius: 6px; overflow: hidden; background: var(--ink); }
  .ch__media::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 6px; background: var(--c); }
  .ch__img { position: absolute; inset: -10% 0; }
  .ch__img :global(.pattern) { height: 100%; border-radius: 0; }
  @media (max-width: 700px) { .ch__media { aspect-ratio: 4 / 3; } }

  .glance { display: grid; grid-template-columns: repeat(4, 1fr); margin: clamp(28px, 4vw, 48px) 0 0; border-top: 1px solid var(--ink); }
  .glance div { display: grid; gap: 8px; padding: 20px 16px 20px 0; }
  .glance div + div { padding-left: 16px; border-left: 1px solid var(--line); }
  .glance dt { color: var(--muted); }
  .glance dd { margin: 0; font-size: var(--step-1); font-weight: 500; }
  @media (max-width: 760px) {
    .glance { grid-template-columns: 1fr 1fr; }
    .glance div:nth-child(3) { padding-left: 0; border-left: 0; }
    .glance div:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }

  .challenge { margin: 0; font-family: var(--f-serif); font-size: var(--step-3); line-height: 1.1; padding-left: 28px; border-left: 3px solid var(--c); }
  .challenge :global(.ph) { white-space: normal; }

  .sol-link { margin-top: 24px; }
  .steps { list-style: none; margin: 0; padding: 0; counter-reset: s; }
  .steps li { display: grid; grid-template-columns: 52px 1fr; gap: 16px; align-items: center; padding: 22px 0; border-top: 1px solid var(--line); font-size: var(--step-1); }
  .steps li:last-child { border-bottom: 1px solid var(--line); }
  .steps__n { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--paper); font-family: var(--f-mono); font-size: 0.85rem; }
  .steps :global(.ph) { white-space: normal; }

  .res { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .res li { display: grid; gap: 10px; align-content: end; min-height: 220px; padding: 28px; border-radius: 6px; background: #0b3a52; }
  .res b { font-size: var(--step-4); font-weight: 560; letter-spacing: -0.04em; line-height: 1; color: var(--print); }
  .res b :global(.ph) { color: var(--print); }
  .res span { color: var(--muted); }
  @media (max-width: 860px) { .res { grid-template-columns: 1fr; } .res li { min-height: 0; } }

  .quote { position: relative; margin: 0 auto; max-width: 1000px; padding-top: 40px; }
  .quote__mark { position: absolute; left: -0.1em; top: -0.35em; font-family: var(--f-serif); font-size: clamp(8rem, 18vw, 16rem); line-height: 1; color: var(--brand); opacity: 0.25; }
  .quote blockquote { position: relative; margin: 0 0 24px; font-family: var(--f-serif); font-size: var(--step-3); line-height: 1.1; }
  .quote blockquote :global(.ph) { white-space: normal; }

  .next { display: block; background: var(--paper-2); overflow: hidden; border-top: 1px solid var(--line); }
  .next__in { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 12px 24px; padding-block: clamp(40px, 6vw, 80px); }
  .next .mono { grid-column: 1 / -1; color: var(--muted); }
  .next__name { font-size: var(--step-3); font-weight: 560; letter-spacing: -0.04em; line-height: 1; max-width: 22ch; transition: transform 0.8s var(--ease); }
  .next__name :global(.ph) { white-space: normal; }
  .next:hover .next__name { transform: translateX(1.5%); }
  .next__go { width: clamp(52px, 6vw, 80px); aspect-ratio: 1; border-radius: 50%; background: var(--ink); color: var(--paper); display: grid; place-items: center; transition: transform 0.8s var(--ease); }
  .next__go :global(.arrow) { width: 40%; height: 40%; }
  .next:hover .next__go { transform: rotate(-45deg); }
</style>
