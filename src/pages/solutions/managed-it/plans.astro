---
import Layout from '../../../layouts/Layout.astro';
import PageHead from '../../../components/PageHead.astro';
import Faq from '../../../components/Faq.astro';
import CTA from '../../../components/CTA.astro';
import Arrow from '../../../components/Arrow.astro';
import Icon from '../../../components/Icon.astro';
import T from '../../../components/T.astro';
import { plans } from '../../../data/content';
import { getSolution } from '../../../data/solutions';
const rowKeys = Object.keys(plans[0].rows);
const faqs = getSolution('managed-it').faqs;
---
<Layout title="Managed IT Support Plans in Ghana | GTHINK" description="Simple Managed IT plans with clear inclusions: helpdesk, monitoring, security, backups, and brand and print support from one team, billed monthly.">
  <PageHead label="Managed IT Plans" title='Simple plans. Predictable costs. <span class="serif">Fewer headaches.</span>' lede="Technology, Brand and Print support from one team, billed monthly." />

  <section class="section">
    <div class="wrap">
      <div class="pcards" data-stagger>
        {plans.map((p) => (
          <article class:list={['pcard', { 'pcard--feat': p.featured }]}>
            {p.featured && <span class="pcard__tag">Most chosen</span>}
            <h2 class="pcard__name">{p.name}</h2>
            <p class="pcard__best"><T text={p.best} /></p>
            <p class="pcard__price"><b><T text={p.price} /></b> <span>{p.per}</span></p>
            <ul class="pcard__rows">
              {Object.entries(p.rows).map(([k, v]) => (
                <li><Icon name="check" /><span><b>{k}</b><br /><T text={v} /></span></li>
              ))}
            </ul>
            <a href="/contact#enquiry" class:list={['btn', { 'btn--ghost': !p.featured }]}>{p.price === 'Custom quote' ? 'Request a Quote' : `Choose ${p.name}`} <Arrow /></a>
          </article>
        ))}
      </div>
      <p class="note">All prices and inclusions to be confirmed by management.</p>

      <h2 class="h3 cmp__h" data-reveal>Compare plans</h2>
      <div class="cmp" data-reveal>
        <table>
          <caption class="sr-only">Plan comparison</caption>
          <thead><tr><th></th>{plans.map((p) => <th scope="col">{p.name}</th>)}</tr></thead>
          <tbody>
            <tr><th scope="row">Best for</th>{plans.map((p) => <td><T text={p.best} /></td>)}</tr>
            <tr><th scope="row">Price</th>{plans.map((p) => <td><T text={`${p.price} ${p.per}`} /></td>)}</tr>
            {rowKeys.map((k) => <tr><th scope="row">{k}</th>{plans.map((p) => <td><T text={(p.rows as any)[k]} /></td>)}</tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section sand">
    <div class="wrap split">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>FAQ</p>
        <h2 class="h2" data-split>Straight <span class="serif">answers.</span></h2>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <CTA />
</Layout>
<style>
  .pcards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; }
  .pcard { position: relative; display: flex; flex-direction: column; gap: 10px; padding: clamp(24px, 2.6vw, 36px); border-radius: 14px; background: var(--surface); border: 1px solid var(--line); }
  .pcard--feat { background: var(--navy); color: #fff; border-color: var(--navy); --muted: #a9c3d2; --line: rgba(255,255,255,0.15); }
  .pcard--feat .btn { background: #fff; color: var(--navy); }
  .pcard--feat .btn:hover { background: var(--sky); }
  .pcard__tag { position: absolute; top: 20px; right: 20px; padding: 5px 10px; border-radius: 6px; background: var(--sky); color: var(--navy-deep); font-size: 0.75rem; font-weight: 700; }
  .pcard__name { font-size: var(--step-2); }
  .pcard:not(.pcard--feat) .pcard__name { color: var(--navy); }
  .pcard__best { color: var(--muted); }
  .pcard__price { margin: 6px 0 10px; }
  .pcard__price b { font-family: var(--f-display); font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem); white-space: nowrap; }
  .pcard__price span { color: var(--muted); }
  .pcard__rows { display: grid; gap: 14px; padding-top: 18px; border-top: 1px solid var(--line); flex: 1; margin-bottom: 18px; }
  .pcard__rows li { display: grid; grid-template-columns: 20px 1fr; gap: 10px; font-size: 0.95rem; }
  .pcard__rows b { font-size: 0.85rem; color: var(--muted); font-weight: 600; }
  .pcard__rows :global(svg) { width: 20px; height: 20px; color: var(--blue); }
  .pcard--feat .pcard__rows :global(svg) { color: var(--sky); }
  .pcard--feat :global(.ph) { color: #a9c3d2; }
  .pcard .btn { align-self: flex-start; }
  .note { margin-top: 16px; font-size: 0.9rem; color: var(--muted); }
  .cmp__h { margin-top: clamp(56px, 7vw, 96px); margin-bottom: 20px; color: var(--navy); }
  .cmp { overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); }
  .cmp table { width: 100%; border-collapse: collapse; min-width: 640px; }
  .cmp th, .cmp td { text-align: left; padding: 16px 20px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .cmp tr:last-child th, .cmp tr:last-child td { border-bottom: 0; }
  .cmp thead th { background: var(--navy); color: #fff; font-family: var(--f-display); font-weight: 700; }
  .cmp tbody th { font-weight: 600; color: var(--navy); width: 20%; background: var(--bg); }
  @media (max-width: 960px) { .pcards { grid-template-columns: 1fr; } }
</style>
