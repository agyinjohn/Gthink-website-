---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Arrow from '../../components/Arrow.astro';
import T from '../../components/T.astro';
import Faq from '../../components/Faq.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { solutions, type Solution } from '../../data/solutions';
import { imgAttrs } from '../../lib/img';

export function getStaticPaths() {
  return solutions.map((s, i) => ({ params: { slug: s.slug }, props: { s, i } }));
}
const { s, i } = Astro.props as { s: Solution; i: number };
const next = solutions[(i + 1) % solutions.length];
const colors = ['tech', 'brand', 'print'];
const c = colors[i % 3];
const presetMap: Record<string, string> = {
  software: 'Software', 'managed-it': 'Managed IT', cybersecurity: 'Cybersecurity', networks: 'Networks', cloud: 'Cloud', 'brand-print': 'Brand and Print',
};
const words = s.headline.split(' ');
const titleHtml = s.headline;
---
<Layout title={s.seoTitle} description={s.intro}>
  <div style={`--c: var(--${c}); --ct: var(--${c === 'print' ? 'print-deep' : c}); --on: var(--${c === 'print' ? 'ink' : 'paper'})`}>
    <PageHead index={`Solution 0${i + 1} / 06`} label={s.name} title={titleHtml} lede={s.intro}>
      <a href="#quote" class="btn" data-magnetic data-reveal="hero">Get a Quote <Arrow /></a>
    </PageHead>

    <!-- outcome band -->
    <section class="band" aria-label="Outcome">
      <div class="band__copy">
        <span class="mono">The outcome</span>
        <p class="band__text" data-split>{s.outcome}</p>
      </div>
      <div class="band__media" aria-hidden="true">
        <img {...imgAttrs(s.bandImg, { widths: [600, 900, 1200, 1600], sizes: '(max-width: 900px) 100vw, 50vw' })} alt="" loading="lazy" decoding="async" data-parallax="0.06" />
      </div>
    </section>

    <!-- problem -->
    <section class="section">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow" data-reveal>The problem</p>
          <h2 class="h2" data-split>Sound familiar?</h2>
        </div>
        <div class="grid-3" data-stagger>
          {s.pains.map((p, k) => (
            <article class="pain">
              <div class="pain__media">
                <img class="pain__img" {...imgAttrs(p.img, { widths: [400, 700, 1000], sizes: '(max-width: 900px) 100vw, 33vw' })} alt="" aria-hidden="true" loading="lazy" decoding="async" />
                <span class="mono pain__n">0{k + 1}</span>
              </div>
              <div class="pain__body">
                <h3 class="pain__t">{p.title}</h3>
                <p class="muted">{p.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- deliver -->
    <section class="section dark">
      <div class="wrap split">
        <div class="sticky">
          <p class="eyebrow" data-reveal>What we deliver</p>
          <h2 class="h2 deliver__h" data-split>Everything in scope, written down.</h2>
          {s.extra && <a href={s.extra.href} class="btn btn--ghost" data-magnetic data-reveal>{s.extra.label} <Arrow /></a>}
        </div>
        <ul class="tick-list" data-stagger>
          {s.deliver.map((d, k) => <li><span class="mono">{String(k + 1).padStart(2, '0')}</span><span><T text={d} /></span></li>)}
        </ul>
      </div>
    </section>

    {s.slug === 'software' && (
      <section class="section gems-mini" id="gems">
        <div class="wrap gems-mini__in">
          <div>
            <p class="eyebrow" data-reveal>Ready-made product</p>
            <h2 class="h2" data-split>GEMS ERP</h2>
          </div>
          <div class="gems-mini__copy">
            <p class="lede" data-reveal>Run your hotel or business from one system. Bookings, billing, ledger, wallet and budgeting in one platform built for Ghanaian businesses. <span class="ph">[Confirm public product name, features and screenshots]</span></p>
            <a href="#quote" class="btn" data-magnetic data-reveal>Request a Demo <Arrow /></a>
          </div>
        </div>
      </section>
    )}

    <!-- how it works -->
    <section class="section sand">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow" data-reveal>How it works</p>
          <h2 class="h2" data-split>Four steps, one team.</h2>
        </div>
        <div class="steps-wrap">
        <hr class="steps__line" data-draw />
        <ol class="steps" data-stagger>
          {s.steps.map((st, k) => (
            <li class="step">
              <span class="step__dot" aria-hidden="true"></span>
              <span class="mono muted">Step 0{k + 1}</span>
              <h3 class="h3">{st.title}</h3>
              <p class="muted">{st.body}</p>
            </li>
          ))}
        </ol>
        </div>
      </div>
    </section>

    <!-- proof -->
    <section class="section">
      <div class="wrap proof2">
        <div class="proof2__case">
          <p class="eyebrow" data-reveal>Proof</p>
          <p class="proof2__res" data-reveal><span class="ph">[Related case study: one result in numbers]</span></p>
          <a href="/case-studies" class="link" data-reveal>Read case studies <Arrow /></a>
        </div>
        <blockquote class="proof2__quote" data-reveal>
          <p class="serif">“<span class="ph">[Client quote focused on a result]</span>”</p>
          <footer class="mono muted"><span class="ph">[Name, Title, Company]</span></footer>
        </blockquote>
      </div>
    </section>

    <!-- faq + form -->
    <section class="section sand" id="quote">
      <div class="wrap split">
        <div>
          <p class="eyebrow" data-reveal>Questions</p>
          <h2 class="h2 faq__h" data-split>Before you ask.</h2>
          <Faq items={s.faqs} />
        </div>
        <div>
          <p class="eyebrow" data-reveal>Get a quote</p>
          <h2 class="h3 form__h" data-split>Tell us what you need. We reply within one business day.</h2>
          <EnquiryForm preset={presetMap[s.slug]} id="quote-form" />
        </div>
      </div>
    </section>

    <!-- next -->
    <a href={`/solutions/${next.slug}`} class="next" data-cursor-text="Next">
      <div class="wrap next__in">
        <span class="mono">Next solution</span>
        <span class="next__name">{next.name}</span>
        <span class="next__go" aria-hidden="true"><Arrow /></span>
      </div>
    </a>
  </div>
</Layout>

<style>
  :global(.phead__title .serif) { color: var(--ct) !important; }
  .band { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: clamp(360px, 42vw, 560px); background: var(--c); color: var(--on); }
  .band__copy {
    display: grid; gap: 22px; align-content: center;
    padding: clamp(48px, 7vw, 100px) clamp(24px, 5vw, 72px) clamp(48px, 7vw, 100px) max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
  }
  .band__text { font-family: var(--f-serif); font-size: var(--step-3); line-height: 1.05; letter-spacing: -0.02em; max-width: 18ch; }
  .band__media { position: relative; overflow: hidden; background: var(--ink); }
  .band__media img { position: absolute; inset: -8% 0; width: 100%; height: 116%; object-fit: cover; display: block; }
  @media (max-width: 900px) {
    .band { grid-template-columns: 1fr; min-height: 0; }
    .band__copy { padding: 48px var(--gutter); }
    .band__media { height: clamp(220px, 56vw, 380px); }
  }

  .pain { display: flex; flex-direction: column; border-radius: 6px; overflow: hidden; background: var(--paper-2); }
  .pain__media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--ink); }
  .pain__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.9s var(--ease); }
  .pain:hover .pain__img { transform: scale(1.05); }
  .pain__media::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: var(--c); }
  .pain__n { position: absolute; left: 14px; top: 14px; padding: 5px 9px; background: var(--paper); color: var(--ink); font-size: 0.66rem; }
  .pain__body { display: grid; gap: 10px; align-content: start; padding: 24px 24px 28px; }
  .pain__t { font-size: var(--step-1); letter-spacing: -0.02em; line-height: 1.15; }

  .deliver__h { margin: 22px 0 32px; }
  .deliver__h .serif, .faq__h .serif { color: var(--c); }
  .faq__h { margin: 22px 0 36px; }
  .form__h { margin: 22px 0 36px; max-width: 22ch; }

  .gems-mini__in { display: grid; grid-template-columns: 1fr 1.3fr; gap: 48px; align-items: end; padding: clamp(32px, 5vw, 72px); background: var(--ink); color: var(--paper); border-radius: 8px; }
  .gems-mini__in .h2 { font-size: var(--step-5); margin-top: 18px; }
  .gems-mini__copy { display: grid; gap: 28px; justify-items: start; }
  .gems-mini .ph { white-space: normal; }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; position: relative; z-index: 1; }
  .step { display: grid; gap: 12px; align-content: start; padding-top: 40px; position: relative; }
  .step__dot { position: absolute; top: 0; left: 0; width: 18px; height: 18px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 6px var(--paper-2); }
  .steps-wrap { position: relative; }
  .steps__line { position: absolute; left: 0; right: 0; top: 9px; border: 0; height: 1px; background: var(--ink); margin: 0; }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr 1fr; } .steps__line { display: none; } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }

  .proof2 { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(32px, 6vw, 96px); align-items: end; }
  .proof2__case { display: grid; gap: 24px; justify-items: start; }
  .proof2__res { font-size: var(--step-2); letter-spacing: -0.03em; line-height: 1.1; }
  .proof2__res .ph, .proof2__quote .ph { white-space: normal; }
  .proof2__quote { margin: 0; padding-left: 32px; border-left: 3px solid var(--c); }
  .proof2__quote p { font-size: var(--step-2); line-height: 1.15; margin-bottom: 20px; }
  @media (max-width: 900px) { .proof2, .gems-mini__in { grid-template-columns: 1fr; } }

  .next { display: block; background: var(--paper-2); color: var(--ink); overflow: hidden; box-shadow: inset 0 6px 0 var(--c); }
  .next .mono { color: var(--muted); }
  .next__in { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 12px 24px; padding-block: clamp(48px, 7vw, 100px); }
  .next .mono { grid-column: 1 / -1; }
  .next__name { font-size: var(--step-5); font-weight: 600; letter-spacing: -0.055em; line-height: 0.9; font-variation-settings: 'opsz' 96, 'wdth' 80; transition: transform 0.8s var(--ease); }
  .next:hover .next__name { transform: translateX(2%); }
  .next__go { width: clamp(56px, 7vw, 96px); aspect-ratio: 1; border-radius: 50%; background: var(--ink); color: var(--paper); display: grid; place-items: center; transition: transform 0.8s var(--ease); }
  .next__go :global(.arrow) { width: 40%; height: 40%; }
  .next:hover .next__go { transform: rotate(-45deg); }
</style>
