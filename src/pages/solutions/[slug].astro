---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import Arrow from '../../components/Arrow.astro';
import Icon from '../../components/Icon.astro';
import T from '../../components/T.astro';
import Faq from '../../components/Faq.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { whatsappHref } from '../../data/site';
import { solutions, type Solution } from '../../data/solutions';

export function getStaticPaths() {
  return solutions.map((s, i) => ({ params: { slug: s.slug }, props: { s, i } }));
}
const { s, i } = Astro.props as { s: Solution; i: number };
const next = solutions[(i + 1) % solutions.length];
const presetMap: Record<string, string> = {
  software: 'Software', 'managed-it': 'Managed IT', cybersecurity: 'Cybersecurity', networks: 'Networks', cloud: 'Cloud', 'brand-print': 'Brand and Print',
};
const words = s.headline.split(' ');
const titleHtml = `${words.slice(0, -2).join(' ')} <span class="serif">${words.slice(-2).join(' ')}</span>`;
---
<Layout title={s.seoTitle} description={s.intro}>
  <PageHead label={s.name} title={titleHtml} lede={s.intro}>
    <a href="#quote" class="btn">Get a Quote <Arrow /></a>
    <a href={whatsappHref(`Hello GTHINK, I would like to ask about ${s.name}.`)} class="btn btn--ghost">Ask on WhatsApp</a>
  </PageHead>

  <!-- outcome -->
  <section class="wrap outcome-wrap">
    <div class="outcome" data-reveal>
      <span class="outcome__icon"><Icon name={s.slug} /></span>
      <div>
        <p class="outcome__label">The outcome</p>
        <p class="outcome__text">{s.outcome}</p>
      </div>
    </div>
  </section>

  <!-- problem -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>The problem</p>
        <h2 class="h2" data-split>Sound <span class="serif">familiar?</span></h2>
      </div>
      <div class="grid-3" data-stagger>
        {s.pains.map((p, k) => (
          <article class="pain">
            <span class="pain__n">{k + 1}</span>
            <h3 class="pain__t">{p.title}</h3>
            <p class="muted">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- deliver -->
  <section class="section dark">
    <div class="wrap split">
      <div class="deliver__intro">
        <p class="eyebrow" data-reveal>What we deliver</p>
        <h2 class="h2" data-split>Everything in scope, <span class="serif">written down.</span></h2>
        {s.extra && <div data-reveal><a href={s.extra.href} class="btn btn--ghost">{s.extra.label} <Arrow /></a></div>}
      </div>
      <ul class="deliver" data-stagger>
        {s.deliver.map((d) => <li><span class="deliver__tick"><Icon name="check" /></span><span><T text={d} /></span></li>)}
      </ul>
    </div>
  </section>

  {s.slug === 'software' && (
    <section class="section--tight" id="gems">
      <div class="wrap">
        <div class="gems" data-reveal>
          <div>
            <p class="eyebrow">Ready-made product</p>
            <h2 class="h2">GEMS ERP</h2>
          </div>
          <div class="gems__copy">
            <p class="lede">Run your hotel or business from one system. Bookings, billing, ledger, wallet and budgeting in one platform built for Ghanaian businesses. <span class="ph">[Confirm public product name, features and screenshots]</span></p>
            <a href="#quote" class="btn">Request a Demo <Arrow /></a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- how it works -->
  <section class="section sand">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>How it works</p>
        <h2 class="h2" data-split>Four steps, <span class="serif">one team.</span></h2>
      </div>
      <ol class="steps" data-stagger>
        {s.steps.map((st, k) => (
          <li class="step">
            <span class="step__n">{k + 1}</span>
            <h3 class="step__t">{st.title}</h3>
            <p class="muted">{st.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- proof -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>Proof</p>
        <h2 class="h2" data-split>Results from <span class="serif">real clients.</span></h2>
      </div>
      <div class="proof" data-stagger>
        <a href="/case-studies" class="proof__case">
          <span class="proof__label">Related case study</span>
          <p class="proof__res"><span class="ph">[One result in numbers]</span></p>
          <span class="link">Read case studies <Arrow /></span>
        </a>
        <figure class="proof__quote">
          <span class="proof__qi"><Icon name="quote" /></span>
          <blockquote>“<span class="ph">[Client quote focused on a result]</span>”</blockquote>
          <figcaption><span class="ph">[Name, Title, Company]</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- faq + form -->
  <section class="section sand" id="quote">
    <div class="wrap split">
      <div>
        <div class="sec-head">
          <p class="eyebrow" data-reveal>Questions</p>
          <h2 class="h2" data-split>Common <span class="serif">questions.</span></h2>
        </div>
        <Faq items={s.faqs} />
      </div>
      <div class="formcard" data-reveal>
        <h2 class="h3">Get a quote</h2>
        <p class="muted">Tell us what you need. We reply within one business day.</p>
        <EnquiryForm preset={presetMap[s.slug]} id="quote-form" />
      </div>
    </div>
  </section>

  <!-- next -->
  <section class="wrap next-wrap">
    <a href={`/solutions/${next.slug}`} class="next">
      <span class="next__icon"><Icon name={next.slug} /></span>
      <span class="next__txt"><span class="next__label">Next solution</span><span class="next__name">{next.name}</span></span>
      <span class="next__go"><Arrow /></span>
    </a>
  </section>
</Layout>

<style>
  .outcome-wrap { padding-top: clamp(32px, 4vw, 48px); }
  .outcome { display: flex; gap: 20px; align-items: center; padding: clamp(22px, 3vw, 32px); border-radius: 12px; background: var(--blue); color: #fff; }
  .outcome__icon { flex: none; width: 56px; height: 56px; border-radius: 12px; background: rgba(255,255,255,0.16); display: grid; place-items: center; }
  .outcome__icon :global(svg) { width: 28px; height: 28px; }
  .outcome__label { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #dcecf4; }
  .outcome__text { font-family: var(--f-display); font-size: var(--step-2); font-weight: 700; line-height: 1.2; }

  .pain { display: grid; gap: 10px; align-content: start; padding: 28px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); }
  .pain__n { width: 36px; height: 36px; border-radius: 50%; background: var(--surface-2); color: var(--blue); display: grid; place-items: center; font-family: var(--f-display); font-weight: 700; margin-bottom: 6px; }
  .pain__t { font-size: var(--step-1); color: var(--navy); }

  .deliver__intro { display: grid; gap: 20px; align-content: start; justify-items: start; }
  .deliver { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .deliver li { display: grid; grid-template-columns: 32px 1fr; gap: 12px; align-items: start; padding: 18px; border-radius: 10px; background: rgba(255,255,255,0.05); border: 1px solid var(--line); font-weight: 500; }
  .deliver__tick { width: 32px; height: 32px; border-radius: 8px; background: var(--blue); color: #fff; display: grid; place-items: center; }
  .deliver__tick :global(svg) { width: 18px; }
  .deliver :global(.ph) { color: var(--muted); }
  @media (max-width: 600px) { .deliver { grid-template-columns: 1fr; } }

  .gems { display: grid; grid-template-columns: 1fr 1.4fr; gap: 32px; align-items: center; padding: clamp(28px, 4vw, 48px); border-radius: 16px; background: var(--navy); color: #fff; }
  .gems .eyebrow { color: var(--sky); }
  .gems .h2 { margin-top: 12px; }
  .gems__copy { display: grid; gap: 20px; justify-items: start; }
  .gems .lede { color: #c4d7e2; }
  .gems .ph { color: #a9c3d2; }
  .gems .btn { background: #fff; color: var(--navy); }
  @media (max-width: 860px) { .gems { grid-template-columns: 1fr; } }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .step { display: grid; gap: 10px; align-content: start; padding: 28px; border-radius: 12px; background: var(--surface); }
  .step__n { width: 40px; height: 40px; border-radius: 50%; background: var(--blue); color: #fff; display: grid; place-items: center; font-family: var(--f-display); font-weight: 700; margin-bottom: 6px; }
  .step__t { font-size: var(--step-1); color: var(--navy); }
  @media (max-width: 960px) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }

  .proof { display: grid; grid-template-columns: 1fr 1.3fr; gap: 20px; }
  .proof__case { display: grid; gap: 14px; align-content: start; padding: 32px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--blue); }
  .proof__label { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--blue); }
  .proof__res { font-family: var(--f-display); font-size: var(--step-2); font-weight: 700; color: var(--navy); }
  .proof__case .link { justify-self: start; }
  .proof__quote { margin: 0; display: grid; gap: 16px; align-content: start; padding: 32px; border-radius: 12px; background: var(--surface-2); }
  .proof__qi { width: 44px; height: 44px; border-radius: 50%; background: var(--blue); color: #fff; display: grid; place-items: center; }
  .proof__qi :global(svg) { width: 20px; }
  .proof__quote blockquote { margin: 0; font-family: var(--f-display); font-size: var(--step-1); font-weight: 600; color: var(--navy); }
  @media (max-width: 860px) { .proof { grid-template-columns: 1fr; } }

  .formcard { display: grid; gap: 12px; align-content: start; padding: clamp(24px, 3vw, 36px); border-radius: 14px; background: var(--surface); border: 1px solid var(--line); }
  .formcard .h3 { color: var(--navy); }
  .formcard .muted { margin-bottom: 8px; }

  .next-wrap { padding-top: clamp(40px, 5vw, 64px); }
  .next { display: flex; align-items: center; gap: 18px; padding: 24px 28px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); transition: border-color 0.25s; }
  .next:hover { border-color: var(--blue); }
  .next__icon { width: 52px; height: 52px; border-radius: 10px; background: var(--surface-2); color: var(--blue); display: grid; place-items: center; flex: none; }
  .next__icon :global(svg) { width: 26px; }
  .next__txt { display: grid; flex: 1; min-width: 0; }
  .next__label { font-size: 0.85rem; color: var(--muted); }
  .next__name { font-family: var(--f-display); font-size: var(--step-2); font-weight: 700; color: var(--navy); }
  .next__go { flex: none; width: 48px; height: 48px; border-radius: 50%; background: var(--blue); color: #fff; display: grid; place-items: center; transition: transform 0.3s var(--ease); }
  .next:hover .next__go { transform: translateX(4px); }
  .next__go :global(.arrow) { width: 18px; }
</style>
