---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import SolutionIndex from '../../components/SolutionIndex.astro';
import CTA from '../../components/CTA.astro';
import Arrow from '../../components/Arrow.astro';
import Icon from '../../components/Icon.astro';
const pillars = [
  { icon: 'software', t: 'Technology', b: 'Software, managed IT, cybersecurity, networks and cloud.' },
  { icon: 'one', t: 'Brand', b: 'Identity, website design, social media and online ads.' },
  { icon: 'brand-print', t: 'Print', b: 'Stationery, brochures, banners, signage and merchandise.' },
];
---
<Layout title="IT, Software, Security and Branding Solutions in Ghana | GTHINK" description="Technology solutions for growing businesses: software, managed IT, cybersecurity, networks, cloud, and brand and print, from one local team.">
  <PageHead label="Solutions" title='Technology solutions for <span class="serif">growing businesses.</span>' lede="Pick what you need today and add more as you grow. Every solution is delivered and supported by the same local team.">
    <a href="/solutions/managed-it/plans" class="btn">Compare Managed IT Plans <Arrow /></a>
  </PageHead>

  <section class="section">
    <div class="wrap"><SolutionIndex /></div>
  </section>

  <section class="section dark">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>One partner</p>
        <h2 class="h2" data-split>Technology, brand and print, <span class="serif">from one team.</span></h2>
        <p class="lede" data-reveal>One account manager, one invoice, and no finger-pointing between suppliers.</p>
      </div>
      <div class="pillars" data-stagger>
        {pillars.map((p) => (
          <div class="pillar">
            <span class="pillar__icon"><Icon name={p.icon} /></span>
            <h3 class="pillar__t">{p.t}</h3>
            <p>{p.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
<style>
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .pillar { display: grid; gap: 10px; align-content: start; padding: 28px; border-radius: 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--line); }
  .pillar__icon { width: 48px; height: 48px; border-radius: 10px; background: var(--blue); color: #fff; display: grid; place-items: center; margin-bottom: 6px; }
  .pillar__icon :global(svg) { width: 24px; }
  .pillar__t { font-size: var(--step-1); }
  .pillar p { color: #c4d7e2; }
  .dark .lede { color: #c4d7e2; }
  @media (max-width: 760px) { .pillars { grid-template-columns: 1fr; } }
</style>
