---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Arrow from '../components/Arrow.astro';
import CTA from '../components/CTA.astro';
import { insights } from '../data/content';
---
<Layout title="Insights: Plain-Language IT Advice for Ghanaian Businesses | GTHINK" description="Helpful, plain-language articles on IT support costs, networks, cybersecurity, the Data Protection Act and business software in Ghana.">
  <PageHead label="Insights" title='Answers to the questions <span class="serif">business owners ask.</span>' lede="Plain-language articles on technology, security and running a growing business in Ghana." />

  <section class="section">
    <div class="wrap">
      <div class="arts" data-stagger>
        {insights.map((a, i) => (
          <article id={a.slug} class:list={['art', { 'art--lead': i === 0 }]}>
            <span class="art__cat">{a.cat}</span>
            <h2 class="art__t">{a.title}</h2>
            <p class="muted">{a.excerpt}</p>
            <span class="art__soon">Article coming soon</span>
          </article>
        ))}
      </div>
      <p class="note">Each article answers the question a business owner would type into Google.</p>
    </div>
  </section>
  <CTA />
</Layout>
<style>
  .arts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .art { display: flex; flex-direction: column; gap: 12px; padding: 28px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); scroll-margin-top: 120px; }
  .art--lead { grid-column: span 2; background: var(--navy); color: #fff; border-color: var(--navy); --muted: #c4d7e2; }
  .art--lead .art__t { color: #fff; font-size: var(--step-3); }
  .art--lead .art__cat { background: rgba(255,255,255,0.14); color: #fff; }
  .art__cat { align-self: flex-start; padding: 4px 10px; border-radius: 6px; background: var(--surface-2); color: var(--blue); font-size: 0.78rem; font-weight: 700; }
  .art__t { font-size: var(--step-1); color: var(--navy); line-height: 1.25; }
  .art .muted { flex: 1; }
  .art__soon { font-size: 0.85rem; font-weight: 600; color: var(--muted); }
  .note { margin-top: 24px; font-size: 0.9rem; color: var(--muted); }
  @media (max-width: 900px) { .arts { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .arts { grid-template-columns: 1fr; } .art--lead { grid-column: auto; } }
</style>
