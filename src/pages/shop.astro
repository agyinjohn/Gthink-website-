---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import Arrow from '../components/Arrow.astro';
import Pattern from '../components/Pattern.astro';
import { whatsappHref } from '../data/site';
const cats = ['Laptops', 'Desktops', 'Printers and Ink', 'Networking', 'Storage', 'Accessories'];
const products = cats.flatMap((c, i) => [0, 1].map((k) => ({ cat: c, seed: i * 2 + k + 30 })));
---
<Layout title="Shop: Genuine Laptops, Printers and Accessories in Accra | GTHINK" description="Genuine computers, printers, networking and accessories, delivered and set up by the GTHINK team.">
  <PageHead index="07 / Shop" label="Shop" title='Genuine computers and accessories, <span class="serif">set up by experts.</span>' lede="Buy from a team that can install, configure and support what you buy.">
    <a href="#corporate" class="btn btn--ghost" data-magnetic data-reveal="hero">Corporate orders <Arrow /></a>
  </PageHead>

  <section class="assure">
    <div class="marquee" data-marquee data-speed="40">
      <div class="marquee__track">
        {['Genuine products', 'Warranty [terms]', 'Delivery [areas]', 'Mobile Money accepted', 'Set up by our engineers'].map((x) => (
          <span class="assure__i mono">✦ {x}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap">
      <div class="cats" role="group" aria-label="Categories" data-reveal>
        <button class="cat on" data-cat="All">All</button>
        {cats.map((c) => <button class="cat" data-cat={c}>{c}</button>)}
      </div>
      <div class="prods" data-stagger>
        {products.map((p) => (
          <article class="prod" data-pcat={p.cat}>
            <div class="prod__img"><Pattern seed={p.seed} dense label={p.cat} /></div>
            <h2 class="prod__n"><span class="ph">[Product name]</span></h2>
            <p class="mono muted"><span class="ph">[Key specs]</span></p>
            <p class="prod__price">GHS <span class="ph">[Price]</span></p>
            <div class="prod__btns">
              <a href={whatsappHref(`Hello GTHINK, I would like to order: ${p.cat}`)} class="btn btn--sm btn--wa">Order on WhatsApp</a>
              <a href="/contact#enquiry" class="link">Request a Quote</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section dark" id="corporate">
    <div class="wrap corp">
      <div>
        <p class="eyebrow" data-reveal>Corporate orders</p>
        <h2 class="h2 corp__h" data-split>Equipping a whole office? <span class="serif">Ask for bulk pricing.</span></h2>
      </div>
      <div class="corp__copy">
        <p class="lede" data-reveal>Bulk pricing and delivery for businesses, with setup, configuration and support by the same team.</p>
        <a href="/contact#enquiry" class="btn" data-magnetic data-reveal>Request a Quote <Arrow /></a>
      </div>
    </div>
  </section>
</Layout>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-cat]');
  const items = document.querySelectorAll<HTMLElement>('[data-pcat]');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.classList.toggle('on', x === b));
    items.forEach((it) => (it.style.display = b.dataset.cat === 'All' || it.dataset.pcat === b.dataset.cat ? '' : 'none'));
  }));
</script>
<style>
  .assure { border-block: 1px solid var(--line); padding-block: 18px; }
  .assure__i { margin-right: 48px; font-size: 0.8rem; }
  .cats { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px; }
  .cat { padding: 10px 16px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line-strong); font-size: 0.92rem; transition: background 0.3s, color 0.3s; }
  .cat.on, .cat:hover { background: var(--ink); color: var(--paper); box-shadow: none; }
  .prods { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px 20px; }
  .prod { display: grid; gap: 8px; align-content: start; }
  .prod__img { aspect-ratio: 1; border-radius: 6px; overflow: hidden; margin-bottom: 10px; }
  .prod__img :global(.pattern) { height: 100%; transition: transform 0.9s var(--ease); }
  .prod:hover .prod__img :global(.pattern) { transform: scale(1.05); }
  .prod__n { font-size: var(--step-1); letter-spacing: -0.02em; }
  .prod__price { font-weight: 560; }
  .prod__btns { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 6px; }
  .corp { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: end; }
  .corp__h { margin-top: 22px; }
  .corp__h .serif { color: var(--print); }
  .corp__copy { display: grid; gap: 28px; justify-items: start; }
  @media (max-width: 1000px) { .prods { grid-template-columns: repeat(2, 1fr); } .corp { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .prods { grid-template-columns: 1fr; } }
</style>
