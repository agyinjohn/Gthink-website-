---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import Ph from '../components/Ph.astro';
import T from '../components/T.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';
import { solutions } from '../data/solutions';
import { insights, cases, plans } from '../data/content';

const proof = [
  { v: site.foundedYear ? 2026 - site.foundedYear : null, label: 'XX', unit: 'Years in business' },
  { v: site.clientsSupported, label: 'XXX', unit: 'Businesses supported', plus: true },
  { v: site.responseHours, label: 'X', unit: 'Hour support response' },
];
const why = [
  { icon: 'one', t: 'One partner, not five', b: 'IT, software, brand and print through one account manager.' },
  { icon: 'shield', t: 'Security built in', b: 'Every system we build is tested against attacks before it goes live.' },
  { icon: 'tag', t: 'Clear pricing', b: 'Published plans with defined inclusions. No surprise bills.' },
  { icon: 'pin', t: 'Local and fast', b: 'Accra-based engineers, on-site when you need us, WhatsApp when you don’t.' },
];
const shopCats = [
  { icon: 'laptops', t: 'Laptops' }, { icon: 'desktops', t: 'Desktops' }, { icon: 'printers', t: 'Printers and Ink' },
  { icon: 'networking', t: 'Networking' }, { icon: 'storage', t: 'Storage' }, { icon: 'accessories', t: 'Accessories' },
];
---
<Layout title="GTHINK | IT Support, Software and Branding for Businesses in Accra">

  <!-- 1. HERO -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal="hero">IT · Software · Security · Brand · Print</p>
        <h1 class="hero__title display" data-split="hero">One partner for your technology, <span class="serif">brand and print.</span></h1>
        <p class="lede" data-reveal="hero">
          We build your software, secure your systems and keep your team running, with local support that responds within <Ph value={site.responseHours && `${site.responseHours} hours`} label="X hours" />. GTHINK handles the technology so you can run the business.
        </p>
        <div class="hero__btns" data-reveal="hero" data-delay="0.08">
          <a href="/contact#enquiry" class="btn">Book a Free IT Assessment <Arrow /></a>
          <a href="/solutions" class="btn btn--ghost">Explore Solutions</a>
        </div>
      </div>

      <div class="hero__art" data-reveal="hero" data-delay="0.15">
        <canvas data-weave role="img" aria-label="Animated artwork: three threads weaving together, for technology, brand and print"></canvas>
        <div class="hero__tag">
          <span class="hero__tag-icon"><Icon name="managed-it" /></span>
          <span><b>Local support</b><br />Accra-based engineers, on-site or on WhatsApp</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PROOF BAR -->
  <section class="proof-wrap" aria-label="GTHINK in numbers">
    <div class="wrap">
      <ul class="proof" data-stagger>
        {proof.map((p) => (
          <li>
            <span class="proof__n">
              {p.v !== null ? <span data-count={p.v}>{p.v}</span> : <span class="ph">[{p.label}]</span>}{p.plus && '+'}
            </span>
            <span class="proof__l">{p.unit}</span>
          </li>
        ))}
        <li>
          <span class="proof__n proof__n--sm">{site.certification ?? <span class="ph">[Certification or partner badge]</span>}</span>
          <span class="proof__l">Verified only</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- 3. CLIENTS -->
  <section class="clients section--tight">
    <div class="wrap">
      <p class="clients__h">Trusted by growing businesses across Ghana</p>
      <ul class="clients__grid" data-stagger>
        {Array.from({ length: 8 }).map((_, i) => <li><span class="ph">[Client logo {i + 1}]</span></li>)}
      </ul>
    </div>
  </section>

  <!-- 4. SOLUTIONS -->
  <section class="section sol" id="solutions">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>Solutions</p>
        <h2 class="h2" data-split>Everything your business runs on, <span class="serif">handled by one team.</span></h2>
        <p class="lede" data-reveal>Pick what you need today and add more as you grow.</p>
      </div>
      <div class="sol__grid" data-stagger>
        {solutions.map((s) => (
          <a href={`/solutions/${s.slug}`} class="sol__card">
            <span class="sol__icon"><Icon name={s.slug} /></span>
            <h3 class="sol__name">{s.name}</h3>
            <p class="sol__short">{s.short}</p>
            <span class="link sol__more">Learn more <Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. WHY GTHINK -->
  <section class="section why dark">
    <div class="wrap why__grid">
      <div class="why__intro">
        <p class="eyebrow" data-reveal>Why GTHINK</p>
        <h2 class="h2" data-split>One partner, <span class="serif">not five.</span></h2>
        <p class="lede" data-reveal>Most businesses juggle an IT vendor, a software house, a security consultant, an agency and a printer. Our clients deal with one team.</p>
        <div data-reveal><a href="/about" class="btn btn--ghost">About GTHINK <Arrow /></a></div>
      </div>
      <ul class="why__list" data-stagger>
        {why.map((w) => (
          <li class="why__item">
            <span class="why__icon"><Icon name={w.icon} /></span>
            <h3 class="why__t">{w.t}</h3>
            <p>{w.b}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. GEMS ERP -->
  <section class="section gems" id="gems">
    <div class="wrap gems__grid">
      <div class="gems__copy">
        <p class="eyebrow" data-reveal>Featured product</p>
        <h2 class="h2" data-split>GEMS ERP: run your hotel or business from <span class="serif">one system.</span></h2>
        <p class="lede" data-reveal>Bookings, billing, ledger, wallet and budgeting in one platform built for Ghanaian businesses. <span class="ph">[Confirm public product name and features]</span></p>
        <ul class="gems__feats" data-stagger>
          {['Bookings', 'Billing', 'Ledger', 'Wallet', 'Budgeting', 'Mobile Money'].map((f) => <li><Icon name="check" />{f}</li>)}
        </ul>
        <div data-reveal><a href="/contact#enquiry" class="btn">Request a Demo <Arrow /></a></div>
      </div>

      <div class="gems__ui" aria-hidden="true" data-reveal>
        <div class="ui">
          <div class="ui__bar"><i></i><i></i><i></i><span>GEMS · Front desk</span></div>
          <div class="ui__body">
            <div class="ui__side">{['Dashboard', 'Bookings', 'Billing', 'Ledger', 'Wallet', 'Budget'].map((x, i) => <span class:list={{ on: i === 1 }}>{x}</span>)}</div>
            <div class="ui__main">
              <div class="ui__kpis">
                <div><span>Occupancy</span><b>—%</b></div>
                <div><span>Arrivals</span><b>—</b></div>
                <div><span>Revenue</span><b>GHS —</b></div>
              </div>
              <div class="ui__cal">
                {Array.from({ length: 6 }).map((_, r) => (
                  <div class="ui__room"><span>{101 + r}</span>
                    <div class="ui__track"><i style={`left:${(r * 17) % 60}%; width:${22 + ((r * 13) % 30)}%`} class={`c${r % 3}`}></i></div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="ui ui--float" data-parallax="-0.15">
          <span class="ui__small">Mobile Money</span>
          <b>Payment received</b>
          <span class="ui__ok"><Icon name="check" /> Reconciled to ledger</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. MANAGED IT PLANS -->
  <section class="section plans sand">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>Managed IT plans (TBP)</p>
        <h2 class="h2" data-split>IT support from GHS <Ph value={site.starterPriceGHS} label="XXX" /> <span class="serif">per month.</span></h2>
        <p class="lede" data-reveal>Choose a plan, and we take care of your systems, security, website and print needs.</p>
      </div>
      <div class="plans__grid" data-stagger>
        {plans.map((p) => (
          <article class:list={['plan', { 'plan--feat': p.featured }]}>
            {p.featured && <span class="plan__tag">Most chosen</span>}
            <h3 class="plan__name">{p.name}</h3>
            <p class="plan__best"><T text={p.best} /></p>
            <p class="plan__price"><b><T text={p.price} /></b> <span>{p.per}</span></p>
            <ul class="plan__rows">
              {Object.entries(p.rows).slice(0, 4).map(([k, v]) => <li><Icon name="check" /><span><b>{k}:</b> <T text={v} /></span></li>)}
            </ul>
          </article>
        ))}
      </div>
      <div class="plans__foot" data-reveal>
        <span class="muted">All prices and inclusions to be confirmed by management.</span>
        <a href="/solutions/managed-it/plans" class="btn btn--ghost">Compare Plans <Arrow /></a>
      </div>
    </div>
  </section>

  <!-- 8. RESULTS -->
  <section class="section results">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>Results</p>
        <h2 class="h2" data-split>Outcomes first, <span class="serif">technology second.</span></h2>
      </div>
      <div class="grid-3" data-stagger>
        {cases.map((c, i) => (
          <a href="/case-studies" class="case">
            <span class="case__n">Case study {i + 1}</span>
            <p class="case__res"><T text={c.result} /></p>
            <div class="case__meta">
              <span><T text={c.client} /> · <T text={c.sector} /></span>
              <span class="case__sol">{c.solution}</span>
            </div>
            <span class="link">Read the story <Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. TESTIMONIAL -->
  <section class="section--tight quote-sec">
    <div class="wrap">
      <figure class="quote" data-reveal>
        <span class="quote__icon"><Icon name="quote" /></span>
        <blockquote><p>“<span class="ph">[Client quote focused on a measurable result, in the client’s own words]</span>”</p></blockquote>
        <figcaption><span class="ph">[Name, Title, Company]</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- 10. SHOP -->
  <section class="section--tight shop">
    <div class="wrap">
      <div class="shop__box">
        <div class="shop__copy">
          <p class="eyebrow" data-reveal>Shop</p>
          <h2 class="h2" data-split>Genuine laptops, printers and accessories.</h2>
          <p data-reveal>Delivered and set up by our team.</p>
          <div data-reveal><a href="/shop" class="btn">Visit the Shop <Arrow /></a></div>
        </div>
        <ul class="shop__cats" data-stagger>
          {shopCats.map((c) => <li><a href="/shop"><Icon name={c.icon} />{c.t}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 11. INSIGHTS -->
  <section class="section insights">
    <div class="wrap">
      <div class="ins__head">
        <div class="sec-head">
          <p class="eyebrow" data-reveal>Latest insights</p>
          <h2 class="h2" data-split>Plain-language advice for <span class="serif">growing businesses.</span></h2>
        </div>
        <a href="/insights" class="link" data-reveal>All articles <Arrow /></a>
      </div>
      <div class="grid-3" data-stagger>
        {insights.slice(0, 3).map((a) => (
          <a href={`/insights#${a.slug}`} class="art">
            <span class="art__cat">{a.cat}</span>
            <h3 class="art__t">{a.title}</h3>
            <p class="muted">{a.excerpt}</p>
            <span class="link">Read article <Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 12. CLOSING CTA -->
  <CTA />
</Layout>

<style>
  /* 1. hero */
  .hero { padding-top: clamp(130px, 14vw, 170px); padding-bottom: clamp(40px, 5vw, 64px); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero__copy { display: grid; gap: 24px; justify-items: start; }
  .hero__title { max-width: 17ch; font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4.6rem); }
  .hero__btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero__art { position: relative; height: clamp(340px, 42vw, 520px); border-radius: 16px; overflow: hidden; background: var(--navy-deep); }
  .hero__art canvas { width: 100%; height: 100%; }
  .hero__tag {
    position: absolute; left: 16px; right: 16px; bottom: 16px;
    display: flex; align-items: center; gap: 14px;
    padding: 14px 16px; border-radius: 10px; background: var(--surface); font-size: 0.9rem; line-height: 1.35; color: var(--ink-2);
  }
  .hero__tag b { color: var(--navy); font-family: var(--f-display); }
  .hero__tag-icon { flex: none; width: 42px; height: 42px; border-radius: 8px; background: var(--blue); color: #fff; display: grid; place-items: center; }
  .hero__tag-icon :global(svg) { width: 22px; }
  @media (max-width: 900px) { .hero__grid { grid-template-columns: 1fr; } .hero__art { height: 340px; } }

  /* 2. proof bar */
  .proof { display: grid; grid-template-columns: repeat(4, 1fr); background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
  .proof li { display: grid; gap: 4px; align-content: start; padding: 24px; border-right: 1px solid var(--line); }
  .proof li:last-child { border-right: 0; }
  .proof__n { font-family: var(--f-display); font-size: var(--step-3); font-weight: 700; color: var(--navy); line-height: 1.1; }
  .proof__n--sm { font-size: var(--step-1); }
  .proof__l { font-size: 0.9rem; color: var(--muted); }
  @media (max-width: 760px) {
    .proof { grid-template-columns: 1fr 1fr; }
    .proof li:nth-child(2) { border-right: 0; }
    .proof li:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }

  /* 3. clients */
  .clients__h { text-align: center; color: var(--muted); font-size: 0.95rem; margin-bottom: 22px; }
  .clients__grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 12px; }
  .clients__grid li { height: 64px; display: grid; place-items: center; border-radius: 8px; border: 1px dashed var(--line-strong); font-size: 0.78rem; text-align: center; padding: 6px; }
  @media (max-width: 900px) { .clients__grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 480px) { .clients__grid { grid-template-columns: repeat(2, 1fr); } }

  /* 4. solutions */
  .sol__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .sol__card {
    display: flex; flex-direction: column; gap: 12px; padding: 28px;
    background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
    transition: border-color 0.25s, box-shadow 0.3s, transform 0.3s var(--ease);
  }
  .sol__card:hover { border-color: var(--blue); box-shadow: 0 20px 40px -28px rgba(7, 47, 67, 0.45); transform: translateY(-4px); }
  .sol__icon { width: 52px; height: 52px; border-radius: 10px; background: var(--surface-2); color: var(--blue); display: grid; place-items: center; margin-bottom: 8px; transition: background 0.25s, color 0.25s; }
  .sol__card:hover .sol__icon { background: var(--blue); color: #fff; }
  .sol__icon :global(svg) { width: 26px; height: 26px; }
  .sol__name { font-size: var(--step-1); color: var(--navy); }
  .sol__short { color: var(--muted); flex: 1; }
  .sol__more { margin-top: 8px; align-self: flex-start; }
  @media (max-width: 900px) { .sol__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .sol__grid { grid-template-columns: 1fr; } }

  /* 5. why */
  .why__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 88px); align-items: start; }
  .why__intro { display: grid; gap: 22px; justify-items: start; }
  .why__intro .lede { color: #c4d7e2; }
  .why__list { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .why__item { padding: 28px; border-radius: 12px; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--line); display: grid; gap: 10px; align-content: start; }
  .why__icon { width: 48px; height: 48px; border-radius: 10px; background: var(--blue); color: #fff; display: grid; place-items: center; margin-bottom: 6px; }
  .why__icon :global(svg) { width: 24px; height: 24px; }
  .why__t { font-size: var(--step-1); }
  .why__item p { color: #c4d7e2; }
  @media (max-width: 900px) { .why__grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .why__list { grid-template-columns: 1fr; } }

  /* 6. gems */
  .gems__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 6vw, 80px); align-items: center; }
  .gems__copy { display: grid; gap: 24px; justify-items: start; }
  .gems__feats { display: grid; grid-template-columns: repeat(3, auto); gap: 10px 24px; }
  .gems__feats li { display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--navy); }
  .gems__feats :global(svg) { width: 18px; height: 18px; color: var(--blue); }
  .gems__ui { position: relative; }
  .ui { background: var(--surface); color: var(--ink); border-radius: 12px; border: 1px solid var(--line); box-shadow: 0 40px 80px -40px rgba(7, 47, 67, 0.5); overflow: hidden; }
  .ui__bar { display: flex; align-items: center; gap: 6px; padding: 12px 14px; background: var(--navy); color: #c4d7e2; font-size: 0.75rem; }
  .ui__bar i { width: 9px; height: 9px; border-radius: 50%; background: rgba(255,255,255,0.3); }
  .ui__bar span { margin-left: 10px; }
  .ui__body { display: grid; grid-template-columns: 118px 1fr; min-height: 360px; }
  .ui__side { display: grid; align-content: start; gap: 4px; padding: 14px 10px; border-right: 1px solid var(--line); background: var(--bg); }
  .ui__side span { font-size: 0.75rem; padding: 7px 9px; border-radius: 6px; color: var(--muted); }
  .ui__side span.on { background: var(--blue); color: #fff; }
  .ui__main { padding: 16px; display: grid; gap: 16px; align-content: start; }
  .ui__kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .ui__kpis div { background: var(--surface-2); border-radius: 8px; padding: 12px; display: grid; gap: 4px; }
  .ui__kpis span { font-size: 0.7rem; color: var(--muted); }
  .ui__kpis b { font-family: var(--f-display); font-size: 1.15rem; color: var(--navy); }
  .ui__cal { display: grid; gap: 8px; }
  .ui__room { display: grid; grid-template-columns: 34px 1fr; gap: 8px; align-items: center; font-size: 0.72rem; color: var(--muted); }
  .ui__track { position: relative; height: 26px; background: repeating-linear-gradient(90deg, var(--surface-2) 0 1px, transparent 1px 14.28%); border-radius: 6px; border: 1px solid var(--line); }
  .ui__track i { position: absolute; top: 3px; bottom: 3px; border-radius: 4px; }
  .ui__track i.c0 { background: var(--blue); } .ui__track i.c1 { background: var(--navy); } .ui__track i.c2 { background: var(--sky); }
  .ui--float { position: absolute; right: -12px; bottom: -24px; padding: 16px 18px; display: grid; gap: 4px; width: 230px; }
  .ui__small { font-size: 0.72rem; color: var(--muted); }
  .ui--float b { font-family: var(--f-display); color: var(--navy); }
  .ui__ok { display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #178a45; }
  .ui__ok :global(svg) { width: 16px; }
  @media (max-width: 900px) {
    .gems__grid { grid-template-columns: 1fr; }
    .ui__body { grid-template-columns: 1fr; }
    .ui__side { display: none; }
    .ui--float { right: 10px; }
  }
  @media (max-width: 480px) { .gems__feats { grid-template-columns: repeat(2, auto); } }

  /* 7. plans */
  .plans__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: start; }
  .plan { position: relative; display: grid; gap: 10px; padding: 28px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); }
  .plan--feat { background: var(--navy); color: #fff; border-color: var(--navy); --muted: #a9c3d2; }
  .plan__tag { position: absolute; top: 20px; right: 20px; padding: 5px 10px; border-radius: 6px; background: var(--sky); color: var(--navy-deep); font-size: 0.75rem; font-weight: 700; }
  .plan__name { font-size: var(--step-1); }
  .plan--feat .plan__name { color: #fff; }
  .plan__best { color: var(--muted); font-size: 0.92rem; }
  .plan__price { margin: 8px 0 6px; }
  .plan__price b { font-family: var(--f-display); font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem); font-weight: 700; white-space: nowrap; }
  .plan__price span { color: var(--muted); }
  .plan__rows { display: grid; gap: 10px; padding-top: 16px; border-top: 1px solid var(--line); }
  .plan--feat .plan__rows { border-color: rgba(255,255,255,0.15); }
  .plan__rows li { display: grid; grid-template-columns: 18px 1fr; gap: 10px; font-size: 0.92rem; }
  .plan__rows :global(svg) { width: 18px; height: 18px; color: var(--blue); margin-top: 2px; }
  .plan--feat .plan__rows :global(svg) { color: var(--sky); }
  .plan--feat :global(.ph) { color: #a9c3d2; }
  .plans__foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 28px; font-size: 0.92rem; }
  @media (max-width: 900px) { .plans__grid { grid-template-columns: 1fr; } }

  /* 8. results */
  .case { display: flex; flex-direction: column; gap: 16px; padding: 28px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--blue); transition: box-shadow 0.3s, transform 0.3s var(--ease); }
  .case:hover { transform: translateY(-4px); box-shadow: 0 20px 40px -28px rgba(7, 47, 67, 0.45); }
  .case__n { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue); }
  .case__res { font-family: var(--f-display); font-size: var(--step-2); font-weight: 700; line-height: 1.15; color: var(--navy); flex: 1; }
  .case__meta { display: grid; gap: 2px; font-size: 0.92rem; padding-top: 14px; border-top: 1px solid var(--line); }
