---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Ph from '../components/Ph.astro';
import T from '../components/T.astro';
import SolutionIndex from '../components/SolutionIndex.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';
import { insights, cases, plans } from '../data/content';

const proof = [
  { v: site.foundedYear ? 2026 - site.foundedYear : null, label: 'XX', unit: 'years in business' },
  { v: site.clientsSupported, label: 'XXX', unit: 'businesses supported', plus: true },
  { v: site.responseHours, label: 'X', unit: 'hour support response' },
];
const why = [
  { n: '01', t: 'One partner, not five.', b: 'IT, software, brand and print through one account manager.', c: 'tech' },
  { n: '02', t: 'Security built in.', b: 'Every system we build is tested against attacks before it goes live.', c: 'brand' },
  { n: '03', t: 'Clear pricing.', b: 'Published plans with defined inclusions. No surprise bills.', c: 'print' },
  { n: '04', t: 'Local and fast.', b: 'Accra-based engineers, on-site when you need us, WhatsApp when you don’t.', c: 'leaf' },
];
const suppliers = [
  { t: 'IT support vendor', x: 12, y: 22, r: -8 },
  { t: 'Software house', x: 80, y: 18, r: 6 },
  { t: 'Security consultant', x: 8, y: 74, r: 5 },
  { t: 'Ad agency', x: 86, y: 70, r: -6 },
  { t: 'Print shop', x: 50, y: 88, r: 3 },
];
import { imgAttrs, heroWidths } from '../lib/img';
const heroImg = imgAttrs(site.heroImage, { widths: heroWidths, sizes: '(max-width: 900px) 100vw, 50vw', quality: 72 });
---
<Layout title="GTHINK | IT Support, Software and Branding for Businesses in Accra" preloadImage={site.heroVideo ? undefined : heroImg}>
  <!-- ============ HERO ============ -->
  <section class="hero" data-hero>
    <div class="wrap hero__grid">
      <div class="hero__copy" data-hero-content>
        <h1 class="hero__title display" data-split="hero">
          One partner for your technology, <span class="serif">brand</span> and <span class="serif t-print-dark">print.</span>
        </h1>
        <p class="lede hero__lede" data-reveal="hero">
          One local team for your software, security and support, responding within <Ph value={site.responseHours && `${site.responseHours} hours`} label="X hours" />.
        </p>
        <div class="hero__btns" data-reveal="hero" data-delay="0.1">
          <a href="/contact#enquiry" class="btn" data-magnetic>Book a Free IT Assessment <Arrow /></a>
          <a href="/solutions" class="btn btn--ghost" data-magnetic>Explore Solutions</a>
        </div>
      </div>

      <div class:list={['hero__visual', { 'hero__visual--video': !!site.heroVideo }]} data-hero-visual>
        {site.heroVideo ? (
          <div class="hero__slice" data-slice>
            <video class="hero__bg" src={site.heroVideo} poster={site.heroImage} autoplay muted loop playsinline preload="metadata" aria-label={site.heroImageAlt} data-hero-video></video>
          </div>
        ) : (
          [0, 1, 2].map((i) => (
            <div class="hero__slice" style={`--i: ${i}`} data-slice>
              <img class="hero__bg" {...heroImg} alt={i === 0 ? site.heroImageAlt : ''} aria-hidden={i === 0 ? undefined : 'true'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
            </div>
          ))
        )}
      </div>
    </div>
  </section>

  <!-- ============ PROOF BAR ============ -->
  <section class="proof-sec" aria-label="GTHINK in numbers">
    <div class="wrap">
      <ul class="proof" data-stagger>
        {proof.map((p) => (
          <li>
            <span class="proof__n">
              {p.v !== null ? <span data-count={p.v}>{p.v}</span> : <span class="ph">[{p.label}]</span>}{p.plus && '+'}
            </span>
            <span class="mono muted">{p.unit}</span>
          </li>
        ))}
        <li>
          <span class="proof__n proof__n--sm">{site.certification ?? <span class="ph">[Certification or partner badge]</span>}</span>
          <span class="mono muted">verified only</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ CLIENTS ============ -->
  <section class="clients">
    <div class="wrap clients__head">
      <span class="mono muted">Trusted by</span>
      <span class="mono muted">[6 to 8 client logos, with permission]</span>
    </div>
    <div class="marquee" data-marquee data-speed="50">
      <div class="marquee__track">
        {Array.from({ length: 8 }).map((_, i) => (
          <span class="logo-slot"><span class="logo-slot__mark" style={`--c: var(--${['tech', 'brand', 'print', 'leaf'][i % 4]})`}></span>Client logo {String(i + 1).padStart(2, '0')}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SOLUTIONS ============ -->
  <section class="section" id="solutions">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow" data-reveal>Solutions</p>
        </div>
        <div>
          <h2 class="h2" data-split>Everything your business runs on, handled by one team.</h2>
        </div>
      </div>
      <SolutionIndex />
      <div class="sol-foot" data-reveal>
        <p class="muted">Pick what you need today and add more as you grow.</p>
        <a href="/solutions" class="link">All solutions <Arrow /></a>
      </div>
    </div>
  </section>

  <!-- ============ WHY: converge ============ -->
  <section class="conv dark" data-converge aria-labelledby="why-title">
    <div class="conv__stage">
      {suppliers.map((s) => (
        <span class="conv__chip" data-chip style={`left:${s.x}%; top:${s.y}%; rotate:${s.r}deg`}>{s.t}</span>
      ))}
      <div class="conv__one" data-one><img src="/logo.png" alt="GTHINK" width="420" height="95" /></div>
    </div>
    <div class="conv__text wrap">
      <p class="eyebrow">Why GTHINK</p>
      <h2 id="why-title" class="conv__h">
        <span class="conv__swap">
          <span data-conv-a>Most businesses juggle <span class="serif">five suppliers.</span></span>
          <span data-conv-b>Our clients deal with <span class="serif">one team.</span></span>
        </span>
      </h2>
    </div>
  </section>

  <section class="section why">
    <div class="wrap split">
      <div class="sticky">
        <p class="eyebrow" data-reveal>Four reasons</p>
        <h2 class="h2 why__h" data-split>Plain promises, kept.</h2>
        <p class="lede muted" data-reveal>Specific claims instead of superlatives. If we cannot prove it, we do not say it.</p>
      </div>
      <div class="why__stack" data-stack>
        {why.map((w, i) => (
          <article class="why__card" data-stack-card style={`--c: var(--${w.c}); top: ${110 + i * 22}px`}>
            <div class="why__art" aria-hidden="true">{Array.from({ length: 12 }).map(() => <i></i>)}</div>
            <span class="mono">{w.n} / 04</span>
            <h3 class="h3">{w.t}</h3>
            <p>{w.b}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ GEMS ERP ============ -->
  <section class="section gems dark watermark" id="gems">
    <div class="wrap gems__grid">
      <div class="gems__copy">
        <p class="eyebrow" data-reveal>Featured product</p>
        <h2 class="h2" data-split>GEMS ERP: run your hotel or business from one system.</h2>
        <p class="lede" data-reveal>Bookings, billing, ledger, wallet and budgeting in one platform built for Ghanaian businesses. <span class="ph">[Confirm public product name and features]</span></p>
        <ul class="gems__feats" data-stagger>
          {['Bookings', 'Billing', 'Ledger', 'Wallet', 'Budgeting', 'Mobile Money'].map((f) => <li class="mono">{f}</li>)}
        </ul>
        <div data-reveal><a href="/contact#enquiry" class="btn" data-magnetic>Request a Demo <Arrow /></a></div>
      </div>

      <div class="gems__ui" aria-hidden="true">
        <div class="ui ui--main" data-parallax="0.06">
          <div class="ui__bar"><i></i><i></i><i></i><span class="mono">gems / front-desk</span></div>
          <div class="ui__body">
            <div class="ui__side">{['Dashboard', 'Bookings', 'Billing', 'Ledger', 'Wallet', 'Budget'].map((x, i) => <span class:list={['mono', { on: i === 1 }]}>{x}</span>)}</div>
            <div class="ui__main">
              <div class="ui__kpis">
                <div><span class="mono">Occupancy</span><b>—%</b></div>
                <div><span class="mono">Arrivals</span><b>—</b></div>
                <div><span class="mono">Revenue</span><b>GHS —</b></div>
              </div>
              <div class="ui__cal">
                {Array.from({ length: 6 }).map((_, r) => (
                  <div class="ui__room"><span class="mono">{101 + r}</span>
                    <div class="ui__track"><i style={`left:${(r * 17) % 60}%; width:${22 + ((r * 13) % 30)}%; --c: var(--${['tech', 'brand', 'print'][r % 3]})`}></i></div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="ui ui--float" data-parallax="-0.25">
          <span class="mono">Mobile Money</span>
          <b>Payment received</b>
          <span class="ui__ok">✓ Reconciled to ledger</span>
        </div>
        <div class="ui ui--chip" data-parallax="-0.4">
          <span class="mono">Room 104</span><b>Checked in</b>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PLANS TEASER ============ -->
  <section class="section plans-t">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>Managed IT plans (TBP)</p>
        <div>
          <h2 class="h2 plans-t__h" data-split>IT support from GHS <Ph value={site.starterPriceGHS} label="XXX" /> per month.</h2>
          <p class="lede muted" data-reveal>Choose a plan, and we take care of your systems, security, website and print needs.</p>
        </div>
      </div>

      <div class="tabs" data-tabs data-reveal>
        <div class="tabs__list" role="tablist" aria-label="Plans">
          <span class="tabs__ind" data-tab-ind></span>
          {plans.map((p, i) => <button role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={p.featured ? 'true' : 'false'}>{p.name}</button>)}
        </div>
        {plans.map((p, i) => (
          <div class="tabs__panel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={!p.featured}>
            <div class="tp__price"><span class="mono muted">Best for: <T text={p.best} /></span><b><T text={p.price} /></b><span class="muted">{p.per}</span></div>
            <dl class="tp__rows">
              {Object.entries(p.rows).map(([k, v]) => <div><dt class="mono">{k}</dt><dd><T text={v} /></dd></div>)}
            </dl>
          </div>
        ))}
        <div class="tabs__foot">
          <span class="mono muted">All prices and inclusions to be confirmed by management.</span>
          <a href="/solutions/managed-it/plans" class="btn btn--ghost" data-magnetic>Compare Plans <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ RESULTS ============ -->
  <section class="section sand results">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>Results</p>
        <h2 class="h2" data-split>Outcomes first, technology second.</h2>
      </div>
      <div class="grid-3" data-stagger>
        {[
          { img: 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=700&q=80&fit=crop', alt: 'Hotel lobby' },
          { img: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=700&q=80&fit=crop', alt: 'IT infrastructure' },
          { img: 'https://images.unsplash.com/photo-1561070791-2526d30994b5?w=700&q=80&fit=crop', alt: 'Brand design' },
        ].map(({ img, alt }, i) => (
          <a href={`/case-studies/${cases[i].slug}`} class="case" style={`--c: var(--${cases[i].thread})`} data-cursor-text="Read">
            <div class="case__img" aria-hidden="true"><img {...imgAttrs(img, { widths: [400, 700, 1000], sizes: '(max-width: 900px) 100vw, 33vw' })} alt={alt} loading="lazy" decoding="async" /></div>
            <span class="mono case__n">Case 0{i + 1}</span>
            <p class="case__res"><T text={cases[i].result} /></p>
            <div class="case__meta">
              <span><T text={cases[i].client} /> · <T text={cases[i].sector} /></span>
              <span class="mono">{cases[i].solution}</span>
            </div>
            <span class="link case__more">Read the story <Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIAL ============ -->
  <section class="section quote">
    <div class="wrap">
      <span class="quote__mark" aria-hidden="true">“</span>
      <blockquote>
        <p class="quote__text" data-split>A client quote that focuses on a measurable result, in the client’s own words.</p>
        <footer class="mono muted" data-reveal><span class="ph">[Name, Title, Company]</span></footer>
      </blockquote>
      <p class="mono muted quote__note">Placeholder: replace with an approved client testimonial.</p>
    </div>
  </section>

  <!-- ============ SHOP STRIP ============ -->
  <section class="shopstrip dark">
    <a href="/shop" class="shopstrip__link" data-cursor-text="Shop">
      <div class="marquee" data-marquee data-speed="70">
        <div class="marquee__track">
          {['Laptops', 'Desktops', 'Printers and Ink', 'Networking', 'Storage', 'Accessories'].map((x, i) => (
            <span class="shopstrip__item">{x}<i style={`--c: var(--${['brand', 'print'][i % 2]})`}></i></span>
          ))}
        </div>
      </div>
    </a>
    <div class="wrap shopstrip__row">
      <p class="lede">Genuine laptops, printers and accessories, delivered and set up by our team.</p>
      <a href="/shop" class="btn" data-magnetic>Visit the Shop <Arrow /></a>
    </div>
  </section>

  <!-- ============ INSIGHTS ============ -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>Latest insights</p>
        <div class="ins-head">
          <h2 class="h2" data-split>Plain-language advice for growing businesses.</h2>
          <a href="/insights" class="link" data-reveal>All articles <Arrow /></a>
        </div>
      </div>
      <div class="arts" data-stagger>
        {insights.slice(0, 3).map((a, i) => (
          <a href={`/insights#${a.slug}`} class="art">
            <span class="mono muted">{String(i + 1).padStart(2, '0')} · {a.cat}</span>
            <h3 class="art__t">{a.title}</h3>
            <p class="muted">{a.excerpt}</p>
            <span class="art__go" aria-hidden="true"><Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  /* hero */
  /* Hero: copy on deep navy, the photo cut into three stepped strips */
  .hero {
    position: relative; overflow: hidden;
    min-height: 100vh; min-height: 100svh;
    display: flex; align-items: stretch;
    background: var(--ink); color: var(--paper);
    --muted: #b9cfdb; --line: rgba(243, 246, 248, 0.2); --line-strong: rgba(243, 246, 248, 0.45);
  }
  .hero__grid {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(32px, 5vw, 80px);
    padding-top: clamp(130px, 15vw, 180px); padding-bottom: clamp(48px, 6vw, 84px);
  }
  .hero__copy { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: clamp(20px, 2.6vw, 32px); }
  .hero__title { max-width: 12.6ch; color: var(--paper); font-size: clamp(2.5rem, 1.2rem + 4.6vw, 6.6rem); }
  .hero__title .serif { color: var(--print); padding-right: 0.04em; }
  .hero__title .t-print-dark { color: var(--paper); }
  .hero__lede { max-width: 34ch; color: #d7e6ee; }
  .hero__lede :global(.ph) { color: #b9cfdb; }
  .hero__btns { display: flex; gap: 10px; flex-wrap: wrap; }
  .hero .btn { --bg: var(--paper); --fg: var(--ink); }
  .hero .btn:hover { color: var(--paper); }
  .hero .btn--ghost { --bg: transparent; --fg: var(--paper); }
  .hero .btn--ghost::before { background: var(--paper); }
  .hero .btn--ghost:hover { color: var(--ink); }

  /* three strips of one photo, each stepped lower than the last */
  .hero__visual {
    position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(8px, 1vw, 14px);
    margin-top: clamp(-30px, -2vw, 0px); margin-bottom: calc(-1 * clamp(48px, 6vw, 84px));
  }
  .hero__slice { position: relative; overflow: hidden; border-radius: 4px; background: #0b3a52; }
  .hero__slice:nth-child(1) { margin-top: 0; margin-bottom: 11vh; }
  .hero__slice:nth-child(2) { margin-top: 5.5vh; margin-bottom: 5.5vh; }
  .hero__slice:nth-child(3) { margin-top: 11vh; margin-bottom: 0; }
  .hero__slice .hero__bg {
    position: absolute; top: 0; height: 100%; max-width: none;
    width: calc(300% + 2 * clamp(8px, 1vw, 14px));
    left: calc(var(--i, 0) * -1 * (100% + clamp(8px, 1vw, 14px)));
    object-fit: cover;
  }
  .hero__slice::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7, 47, 67, 0) 55%, rgba(7, 47, 67, 0.35)); pointer-events: none; }
  .hero__visual--video { grid-template-columns: 1fr; }
  .hero__visual--video .hero__slice { margin: 0; }
  .hero__visual--video .hero__bg { width: 100%; left: 0; }

  @media (max-width: 900px) {
    .hero { min-height: 0; display: block; }
    .hero__grid { grid-template-columns: 1fr; gap: 36px; padding-top: 128px; padding-bottom: 0; }
    .hero__visual { height: clamp(240px, 62vw, 420px); margin: 0 0 -1px; }
    .hero__slice:nth-child(1) { margin-bottom: 44px; }
    .hero__slice:nth-child(2) { margin-top: 22px; margin-bottom: 22px; }
    .hero__slice:nth-child(3) { margin-top: 44px; }
    .hero__slice { border-radius: 4px 4px 0 0; }
  }

  .proof-sec { position: relative; }

  .proof { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--line); }
  .proof li { display: grid; gap: 6px; padding: 28px 20px 28px 0; border-right: 1px solid var(--line); }
  .proof li + li { padding-left: 20px; }
  .proof li:last-child { border-right: 0; }
  .proof__n { font-size: var(--step-3); font-weight: 560; letter-spacing: -0.05em; line-height: 1; font-variation-settings: 'opsz' 96, 'wdth' 85; }
  .proof__n .ph { font-size: 0.8em; }
  .proof__n--sm { font-size: var(--step-1); letter-spacing: -0.01em; }
  @media (max-width: 760px) {
    .proof { grid-template-columns: 1fr 1fr; }
    .proof li:nth-child(2) { border-right: 0; }
    .proof li:nth-child(3) { padding-left: 0; }
    .proof li:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }

  /* clients */
  .clients { padding-block: 48px 24px; }
  .clients__head { display: flex; justify-content: space-between; margin-bottom: 22px; }
  .logo-slot {
    display: inline-flex; align-items: center; gap: 12px;
    margin-right: clamp(40px, 6vw, 96px);
    font-size: clamp(1.4rem, 2.6vw, 2.4rem); font-weight: 600; letter-spacing: -0.04em; color: var(--muted);
    font-variation-settings: 'opsz' 96, 'wdth' 80;
  }
  .logo-slot__mark { width: 0.9em; height: 0.9em; background: var(--c); border-radius: 50% 0 50% 50%; opacity: 0.85; }
  .logo-slot:nth-child(even) .logo-slot__mark { border-radius: 0; transform: rotate(45deg) scale(0.75); }

  .sol-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 28px; gap: 16px; flex-wrap: wrap; }

  /* converge */
  .conv { position: relative; height: 100vh; min-height: 560px; overflow: hidden; }
  .conv__stage { position: absolute; inset: 0; }
  .conv__chip {
    position: absolute; translate: -50% -50%;
    padding: 14px 22px; border-radius: 999px; white-space: nowrap;
    box-shadow: inset 0 0 0 1px rgba(243,246,248,0.4);
    font-size: clamp(0.95rem, 1.4vw, 1.25rem); letter-spacing: -0.01em; background: var(--ink);
  }
  .conv__chip:nth-child(1) { box-shadow: inset 0 0 0 1.5px var(--paper); }
  .conv__chip:nth-child(2) { box-shadow: inset 0 0 0 1.5px var(--brand); }
  .conv__chip:nth-child(3) { box-shadow: inset 0 0 0 1.5px var(--print); }
  .conv__one {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    padding: clamp(18px, 2.4vw, 32px) clamp(26px, 3.4vw, 48px); border-radius: 999px; background: var(--paper);
    opacity: 0;
  }
  .conv__one img { width: clamp(200px, 30vw, 420px); height: auto; }
  .conv__text { position: absolute; left: 0; right: 0; top: clamp(90px, 13vh, 140px); text-align: center; display: grid; justify-items: center; gap: 18px; }
  .conv__h { font-size: var(--step-3); max-width: 18ch; }
  .conv__h .serif { color: var(--print); }
  .conv__swap { display: grid; overflow: hidden; }
  .conv__swap > span { grid-area: 1 / 1; }
  [data-conv-b] { opacity: 0; }
  @media (max-width: 640px) {
    .conv__chip { padding: 10px 14px; }
  }

  /* why */
  .why__h { margin: 22px 0 24px; }
  .why__h .serif { color: var(--brand); }
  .why__stack { display: grid; gap: 22px; }
  .why__card {
    position: sticky; min-height: 340px; padding: clamp(28px, 3vw, 44px);
    background: var(--paper-2); border-radius: 6px; overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 14px;
    box-shadow: 0 0 0 1px var(--line);
    transform-origin: top center;
  }
  .why__card { padding-right: calc(46% + 32px); }
  .why__card .mono { position: absolute; top: 28px; left: clamp(28px, 3vw, 44px); color: var(--muted); }
  .why__card h3 { font-size: var(--step-2); max-width: 12ch; }
  .why__card p { max-width: 40ch; font-size: var(--step-1); line-height: 1.35; color: var(--ink-2); }
  .why__art { position: absolute; right: 0; top: 0; width: 46%; height: 100%; display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(3, 1fr); }
  .why__art i { background: var(--c); }
  .why__art i:nth-child(3n) { background: repeating-linear-gradient(90deg, var(--c) 0 6px, transparent 6px 12px); }
  .why__art i:nth-child(4n+1) { background: transparent; }
