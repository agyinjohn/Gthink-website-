---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import CTA from '../components/CTA.astro';
import Arrow from '../components/Arrow.astro';
import Ph from '../components/Ph.astro';
import Pattern from '../components/Pattern.astro';
import { site } from '../data/site';
const values = [
  { t: 'Reliability', b: 'We do what we promise.', c: 'print', img: 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=600&q=80&fit=crop' },
  { t: 'Security', b: 'Protection is built in, not added later.', c: 'brand', img: 'https://images.unsplash.com/photo-1563986768609-322da13575f3?w=600&q=80&fit=crop' },
  { t: 'Clarity', b: 'Plain advice and honest pricing.', c: 'print', img: 'https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=600&q=80&fit=crop' },
  { t: 'Ownership', b: 'We treat your systems like our own.', c: 'leaf', img: 'https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=600&q=80&fit=crop' },
];
const sinceTitle = site.foundedYear
  ? `Helping Ghanaian businesses work smarter since ${site.foundedYear}.`
  : 'Helping Ghanaian businesses work smarter since <span class="ph">[year]</span>.';
---
<Layout title="About GTHINK | IT Company in Accra, Ghana" description="GTHINK Company Limited: developers, engineers and designers in Accra helping Ghanaian businesses with technology, brand and print.">
  <PageHead index="06 / About" label="Our story" title={sinceTitle}>
  </PageHead>

  <section class="section--tight">
    <div class="wrap split">
      <div class="sticky"><p class="eyebrow" data-reveal>Our story</p></div>
      <div class="story">
        <p class="story__lead" data-split>GTHINK Company Limited started with a simple idea: businesses should not need five suppliers to keep their technology, brand and print running.</p>
        <p class="lede muted" data-reveal>Today our team of developers, engineers and designers in Accra supports <Ph value={site.clientsSupported} label="XXX" /> organisations across Ghana.</p>
        <ol class="tl" data-stagger>
          {['[Year] · Founded in Accra', '[Year] · [Milestone]', '[Year] · [Milestone]', '[Year] · [Milestone]'].map((m, i) => {
            const [y, t] = m.split(' · ');
            return <li><span class="tl__y"><span class="ph">{y}</span></span><span class="tl__t">{t.startsWith('[') ? <span class="ph">{t}</span> : t}</span></li>;
          })}
        </ol>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>Mission and values</p>
        <h2 class="h2 mission" data-split>To give growing businesses dependable, secure technology and a professional brand, delivered by one trusted local partner.</h2>
      </div>
      <div class="vals" data-stagger>
        {values.map((v, i) => (
          <div class="val" style={`--c: var(--${v.c})`}>
            <img class="val__img" src={v.img} alt="" loading="lazy" aria-hidden="true" />
            <div class="val__overlay" aria-hidden="true"></div>
            <span class="mono muted">0{i + 1}</span>
            <h3 class="h3">{v.t}</h3>
            <p class="muted">{v.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="leadership">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>Leadership</p>
        <h2 class="h2" data-split>The people accountable.</h2>
      </div>
      <div class="ceo">
        <Pattern seed={11} label="CEO photo" class="ceo__img" img="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=600&q=80&fit=crop" />
        <blockquote class="ceo__q">
          <p class="serif" data-reveal>“<span class="ph">[CEO message, 3 to 4 sentences]</span>”</p>
          <footer data-reveal><b>{site.ceo.name}</b><span class="mono muted">{site.ceo.role}</span></footer>
        </blockquote>
      </div>
      <div class="team" data-stagger>
        {[
          'https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=400&q=80&fit=crop',
          'https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?w=400&q=80&fit=crop',
          'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80&fit=crop',
          'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=400&q=80&fit=crop',
        ].map((imgUrl, n) => (
          <article class="person">
            <Pattern seed={(n+1) * 5} label="Photo" class="person__img" img={imgUrl} />
            <h3 class="person__n"><span class="ph">[Name]</span></h3>
            <p class="mono muted"><span class="ph">[Role]</span></p>
            <p class="muted"><span class="ph">[Short bio]</span></p>
            <span class="mono"><span class="ph">[LinkedIn]</span></span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section sand" id="awards">
    <div class="wrap split">
      <div>
        <p class="eyebrow" data-reveal>Awards, certifications and partners</p>
        <h2 class="h2 aw__h" data-split>Recognition we actually hold.</h2>
      </div>
      <ul class="aw" data-stagger>
        {['[Award, e.g. GITTA]', '[Certification, e.g. ISO 27001, if pursued]', '[Vendor partnership]', '[Vendor partnership]'].map((a, i) => (
          <li><span class="mono muted">0{i + 1}</span><span class="ph">{a}</span><span class="mono muted"><span class="ph">[Year]</span></span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section dark" id="careers">
    <div class="wrap careers">
      <p class="eyebrow" data-reveal>Careers</p>
      <h2 class="careers__h" data-split>Grow your career with us.</h2>
      <div class="careers__row">
        <p class="lede" data-reveal>We hire curious developers, engineers, designers and support specialists. <span class="ph">[Open roles, internship and national service details]</span></p>
        <a href="/contact#enquiry" class="btn" data-magnetic data-reveal>View Open Roles <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="section" id="gallery">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>Gallery</p>
        <h2 class="h2" data-split>Team, office, events and projects.</h2>
      </div>
      <div class="gal">
        {[
          { label: 'Team photo',    img: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=900&q=80&fit=crop' },
          { label: 'Office photo',  img: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=700&q=80&fit=crop' },
          { label: 'Event photo',   img: 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&q=80&fit=crop' },
          { label: 'Project photo', img: 'https://images.unsplash.com/photo-1531403009284-440f080d1e12?w=700&q=80&fit=crop' },
          { label: 'Team photo',    img: 'https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=900&q=80&fit=crop' },
          { label: 'Office photo',  img: 'https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=600&q=80&fit=crop' },
        ].map(({ label, img }, n) => (
          <div class={`gal__i gal__i--${n}`}><div class="gal__p" data-parallax="0.08"><Pattern seed={n * 3 + 20} dense label={label} img={img} /></div></div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
<style>
  .story { display: grid; gap: 32px; }
  .story__lead { font-size: var(--step-3); letter-spacing: -0.035em; line-height: 1.02; font-weight: 520; font-variation-settings: 'opsz' 96, 'wdth' 88; }
  .tl { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .tl li { display: grid; grid-template-columns: 140px 1fr; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line); font-size: var(--step-1); }
  .mission { max-width: 22ch !important; font-size: var(--step-2) !important; line-height: 1.05; }
  .mission .serif { color: var(--print); }
  .vals { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .val { position: relative; overflow: hidden; min-height: 300px; padding: 24px; border-radius: 6px; background: #0b3a52; display: flex; flex-direction: column; justify-content: flex-end; gap: 10px; }
  .val .mono { position: absolute; top: 20px; left: 24px; z-index: 2; }
  .val__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.9s var(--ease); filter: brightness(0.45); }
  .val:hover .val__img { transform: scale(1.06); filter: brightness(0.35); }
  .val__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(7,47,67,0.85) 40%, transparent); }
  .val h3, .val p { position: relative; z-index: 2; }
  .ceo { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(28px, 5vw, 80px); align-items: end; margin-bottom: 72px; }
  .ceo :global(.ceo__img) { aspect-ratio: 4 / 5; }
  .ceo__q { margin: 0; }
  .ceo__q p { font-size: var(--step-3); line-height: 1.05; margin-bottom: 28px; }
  .ceo__q .ph { white-space: normal; }
  .ceo__q footer { display: grid; gap: 4px; }
  .team { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .person { display: grid; gap: 8px; }
  .person :global(.person__img) { aspect-ratio: 4 / 5; margin-bottom: 10px; }
  .person__n { font-size: var(--step-1); }
  .aw__h { margin-top: 22px; }
  .aw__h .serif { color: var(--brand); }
  .aw li { display: grid; grid-template-columns: 50px 1fr auto; gap: 16px; padding: 22px 0; border-top: 1px solid var(--line); font-size: var(--step-1); }
  .aw li:last-child { border-bottom: 1px solid var(--line); }
  .aw .ph { white-space: normal; }
  .careers__h { font-size: var(--step-5); margin: 24px 0 40px; max-width: 12ch; }
  .careers__h .serif { color: var(--print); }
  .careers__row { display: flex; justify-content: space-between; align-items: flex-end; gap: 28px; flex-wrap: wrap; }
  .careers__row .ph { white-space: normal; }
  .gal { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: 90px; gap: 14px; }
  .gal__i { overflow: hidden; border-radius: 6px; }
  .gal__p { height: 120%; margin-top: -10%; }
  .gal__p :global(.pattern) { height: 100%; }
  .gal__i--0 { grid-column: 1 / 6; grid-row: span 4; }
  .gal__i--1 { grid-column: 6 / 10; grid-row: span 3; }
  .gal__i--2 { grid-column: 10 / 13; grid-row: span 5; }
  .gal__i--3 { grid-column: 1 / 4; grid-row: span 3; }
  .gal__i--4 { grid-column: 4 / 10; grid-row: span 4; }
  .gal__i--5 { grid-column: 10 / 13; grid-row: span 2; }
  @media (max-width: 900px) {
    .vals, .team { grid-template-columns: 1fr 1fr; }
    .ceo { grid-template-columns: 1fr; }
    .gal { grid-template-columns: 1fr 1fr; grid-auto-rows: 160px; }
    .gal__i { grid-column: auto !important; grid-row: span 1 !important; }
    .gal__i--0, .gal__i--4 { grid-column: 1 / -1 !important; grid-row: span 2 !important; }
  }
  @media (max-width: 520px) { .vals, .team { grid-template-columns: 1fr; } .tl li { grid-template-columns: 90px 1fr; } }
</style>
