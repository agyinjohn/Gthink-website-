---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import CTA from '../components/CTA.astro';
import Arrow from '../components/Arrow.astro';
import Icon from '../components/Icon.astro';
import { industries } from '../data/content';
const icons = ['hospitality', 'retail', 'education', 'healthcare', 'finance', 'sme'];
---
<Layout title="Industries We Serve | GTHINK, Accra" description="IT, software and brand solutions for hospitality, retail, education, healthcare, finance and SMEs in Ghana.">
  <PageHead label="Industries" title='Built for the way <span class="serif">your industry works.</span>' lede="Six sectors we know well, and the systems each one depends on." />

  <section class="section">
    <div class="wrap">
      <div class="inds" data-stagger>
        {industries.map((ind, i) => (
          <a href="/case-studies" class="ind">
            <span class="ind__icon"><Icon name={icons[i]} /></span>
            <h2 class="ind__name">{ind.name}</h2>
            <p class="muted">{ind.body}</p>
            <ul class="ind__tags">{ind.tags.map((t) => <li>{t}</li>)}</ul>
            <span class="link">See related case studies <Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA title='Don’t see your sector? <span class="serif">Talk to us anyway.</span>' />
</Layout>
<style>
  .inds { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .ind { display: flex; flex-direction: column; gap: 12px; padding: 28px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); transition: border-color 0.25s, transform 0.3s var(--ease), box-shadow 0.3s; }
  .ind:hover { border-color: var(--blue); transform: translateY(-4px); box-shadow: 0 20px 40px -28px rgba(7, 47, 67, 0.45); }
  .ind__icon { width: 56px; height: 56px; border-radius: 12px; background: var(--navy); color: #fff; display: grid; place-items: center; margin-bottom: 6px; }
  .ind:hover .ind__icon { background: var(--blue); }
  .ind__icon :global(svg) { width: 28px; }
  .ind__name { font-size: var(--step-1); color: var(--navy); }
  .ind .muted { flex: 1; }
  .ind__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .ind__tags li { padding: 4px 10px; border-radius: 6px; background: var(--surface-2); color: var(--navy); font-size: 0.8rem; font-weight: 600; }
  .ind .link { align-self: flex-start; margin-top: 4px; }
  @media (max-width: 900px) { .inds { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .inds { grid-template-columns: 1fr; } }
</style>
