---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import CTA from '../components/CTA.astro';
import Arrow from '../components/Arrow.astro';
import Pattern from '../components/Pattern.astro';
import { industries } from '../data/content';
const industryImgs = [
  'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800&q=80&fit=crop', // hospitality
  'https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=800&q=80&fit=crop', // retail
  'https://images.unsplash.com/photo-1580582932707-520aed937b7b?w=800&q=80&fit=crop', // education
  'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=800&q=80&fit=crop', // healthcare
  'https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=800&q=80&fit=crop', // finance
  'https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&q=80&fit=crop', // SMEs
];
--- title="Industries We Serve | GTHINK, Accra" description="IT, software and brand solutions for hospitality, retail, education, healthcare, finance and SMEs in Ghana.">
  <PageHead index="04 / Industries" label="Industries" title='Built for the way <span class="serif">your industry works.</span>' lede="Six sectors we know well, and the systems each one depends on." />

  <section class="hs" data-hscroll>
    <div class="hs__track" data-htrack>
      {industries.map((ind, i) => (
        <a href="/case-studies" class="ind" data-cursor-text="Cases" style={`--c: var(--${['tech', 'brand', 'print'][i % 3]})`}>
          <Pattern seed={i + 3} class="ind__art" img={industryImgs[i]} />
          <span class="mono ind__n">0{i + 1} / 06</span>
          <h2 class="ind__name">{ind.name}</h2>
          <p class="ind__body">{ind.body}</p>
          <ul class="ind__tags">{ind.tags.map((t) => <li class="mono">{t}</li>)}</ul>
          <span class="link ind__link">See related case studies <Arrow /></span>
        </a>
      ))}
    </div>
    <div class="hs__bar" aria-hidden="true"><i data-hbar></i></div>
  </section>

  <CTA title='Don’t see your sector? <span class="serif">Talk to us anyway.</span>' />
</Layout>
<style>
  .hs { position: relative; padding-block: clamp(40px, 6vw, 80px); overflow: hidden; }
  .hs__track { display: flex; gap: 20px; padding-inline: var(--gutter); width: max-content; }
  .ind {
    position: relative; flex: 0 0 clamp(300px, 34vw, 520px); height: min(72vh, 640px); min-height: 520px;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 14px;
    padding: 28px; border-radius: 8px; background: var(--paper-2); overflow: hidden;
  }
  .ind :global(.ind__art) { position: absolute; left: 0; right: 0; top: 0; height: 46%; border-radius: 0; transition: height 0.8s var(--ease); }
  .ind:hover :global(.ind__art) { height: 52%; }
  .ind__n { position: absolute; top: 18px; right: 18px; z-index: 1; background: var(--paper); padding: 5px 8px; font-size: 0.66rem; }
  .ind__name { font-size: var(--step-3); max-width: 10ch; }
  .ind__body { color: var(--ink-2); max-width: 32ch; }
  .ind__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .ind__tags li { font-size: 0.64rem; padding: 6px 10px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line-strong); }
  .ind__link { align-self: flex-start; margin-top: 8px; }
  .hs__bar { margin: 36px var(--gutter) 0; height: 2px; background: var(--line); }
  .hs__bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--tech), var(--brand), var(--print)); transform: scaleX(0); transform-origin: left; }
  @media (max-width: 899px) {
    .hs__track { flex-direction: column; width: auto; }
    .ind { flex: none; height: auto; min-height: 480px; }
    .hs__bar { display: none; }
  }
</style>
