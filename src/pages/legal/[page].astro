---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
export function getStaticPaths() {
  return [
    { params: { page: 'privacy' }, props: { title: 'Privacy Policy', body: 'How GTHINK Company Limited collects, uses and protects personal data, in line with the Data Protection Act, 2012 (Act 843).' } },
    { params: { page: 'terms' }, props: { title: 'Terms', body: 'The terms that apply to using this website and our services.' } },
    { params: { page: 'cookies' }, props: { title: 'Cookie Policy', body: 'Which cookies this site uses, why, and how to change your choice.' } },
  ];
}
const { title, body } = Astro.props;
---
<Layout title={`${title} | GTHINK`}>
  <PageHead label={title} title={title} lede={body} />
  <section class="section">
    <div class="wrap prose" style="max-width: 820px; margin-left: 0;">
      <p><span class="ph">[Full {title.toLowerCase()} text to be provided and reviewed by counsel before launch]</span></p>
      {Astro.params.page === 'cookies' && (
        <p style="margin-top: 1.5em"><button class="btn btn--ghost btn--sm" onclick="try{localStorage.removeItem('gt-cookie')}catch(e){};location.reload()">Change cookie choice</button></p>
      )}
    </div>
  </section>
</Layout>
