---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Arrow from '../components/Arrow.astro';
import { site, whatsappHref } from '../data/site';
const info = [
  { k: 'Office', v: site.address, ph: '[Address], Accra' },
  { k: 'GPS', v: site.gps, ph: '[GA-XXX-XXXX]' },
  { k: 'Phone', v: site.phone, ph: '[+233]' },
  { k: 'Email', v: site.email, ph: '[email]' },
  { k: 'Hours', v: site.hours, ph: '[Mon to Fri, 8am to 5pm]' },
];
---
<Layout title="Contact GTHINK | Accra, Ghana" description="Talk to GTHINK about software, managed IT, cybersecurity, networks, cloud, brand and print.">
  <PageHead label="Contact" title='Let’s talk about <span class="serif">your business.</span>' lede="Tell us what you need. We reply within one business day.">
    <a href="/support" class="btn btn--ghost" data-reveal="hero">Existing client? Get support <Arrow /></a>
  </PageHead>

  <section class="section">
    <div class="wrap split">
      <aside class="info">
        <dl data-stagger>
          {info.map((i) => <div><dt>{i.k}</dt><dd>{i.v ?? <span class="ph">{i.ph}</span>}</dd></div>)}
        </dl>
        <a href={whatsappHref()} class="btn btn--wa" data-reveal>Chat on WhatsApp <Arrow /></a>
        <div class="map" aria-hidden="true" data-reveal>
          <svg viewBox="0 0 400 260">
            <rect width="400" height="260" fill="#072f43" />
            {Array.from({ length: 14 }).map((_, i) => <path d={`M0 ${i * 20 + 6} Q 200 ${i * 20 + (i % 2 ? 30 : -20)} 400 ${i * 20 + 10}`} stroke="#ffffff" stroke-opacity="0.12" fill="none" />)}
            <path d="M40 220 L130 120 L220 150 L330 50" stroke="#0a7fae" stroke-width="10" fill="none" />
            <path d="M20 80 L160 160 L380 200" stroke="#7cc6e6" stroke-width="10" fill="none" />
            <path d="M210 0 L190 260" stroke="#0a4561" stroke-width="10" fill="none" />
            <circle cx="196" cy="150" r="16" fill="#ffffff" />
            <circle cx="196" cy="150" r="6" fill="#072f43" />
          </svg>
          <span class="mono">Accra · <span class="ph">[map embed]</span></span>
        </div>
      </aside>
      <div class="formcard">
        <h2 class="h3">Send an enquiry</h2>
        <EnquiryForm />
      </div>
    </div>
  </section>
</Layout>
<style>
  .info { display: grid; gap: 28px; align-content: start; }
  .info dl { margin: 0; border-top: 1px solid var(--line); }
  .info dl div { display: grid; grid-template-columns: 80px 1fr; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .info dt { font-weight: 700; color: var(--navy); }
  .formcard { display: grid; gap: 20px; align-content: start; padding: clamp(24px, 3vw, 36px); border-radius: 14px; background: var(--surface); border: 1px solid var(--line); }
  .formcard .h3 { color: var(--navy); }
  .info dd { margin: 0; }
  .info .btn { justify-self: start; }
  .map { position: relative; border-radius: 6px; overflow: hidden; }
  .map svg { width: 100%; height: auto; }
  .map .mono { position: absolute; left: 12px; bottom: 12px; background: #fff; color: var(--navy); padding: 5px 8px; border-radius: 6px; font-size: 0.7rem; }
  .map { border-radius: 12px; }
</style>
